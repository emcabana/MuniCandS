# Estimación paralela de potencias para MuniCandS#
# Cada escenario (alternativa, parámetro) se ejecuta en un proceso independiente.#
#
library(Directional)#
library(sphunif)#
library(MASS)#
library(Rcpp)#
library(mvtnorm)#
library(MuniCandS)#
library(copula)#
library(parallel)#
#
# Ajustar si el archivo C++ se encuentra en otra ubicación.#
cpp_file <- path.expand("~/MuniCandS/src/funciones.cpp")#
if (!file.exists(cpp_file)) {#
  stop("No se encontró el archivo C++: ", cpp_file)#
}#
Rcpp::sourceCpp(cpp_file, env = globalenv())#
#
# C2S se compila en cada sesión R. Esta envoltura busca la versión que#
# corresponde al proceso actual, incluido cada trabajador paralelo.#
aplicar_C2S <- function(x) {#
  get("C2S", envir = .GlobalEnv, inherits = FALSE)(x)#
}#
#
evlin <- function(u, f) {#
  ff <- c(0, sort(f), 1)#
  sf <- max(which(ff <= u))#
  if (sf == length(ff)) {#
    return(1)#
  }#
  ((u - ff[sf]) * sf + (ff[sf + 1] - u) * (sf - 1)) /#
    ((ff[sf + 1] - ff[sf]) * (length(f) + 1))#
}#
#
HR.test <- function(x, B = 500) {#
  n <- nrow(x)#
  p <- ncol(x)#
#
  theta <- acos(pmin(pmax(x %*% t(x), -1), 1))#
  stat_obs <- sum(cos(theta[lower.tri(theta)]))#
#
  stat_boot <- numeric(B)#
  for (b in seq_len(B)) {#
    u <- matrix(rnorm(n * p), n, p)#
    u <- u / sqrt(rowSums(u^2))#
    theta_b <- acos(pmin(pmax(u %*% t(u), -1), 1))#
    stat_boot[b] <- sum(cos(theta_b[lower.tri(theta_b)]))#
  }#
#
  list(statistic = stat_obs, p.value = mean(stat_boot >= stat_obs))#
}#
#
muesnorm <- function(n, p, rho) {#
  mues <- do.call(rbind, lapply(seq_len(n), function(i) {#
    aplicar_C2S(rCopula(1, normalCopula(rho, p)))#
  }))#
  mues#
}#
#
# Ambas funciones generan una muestra de tamaño n (no n^2).#
muesclay <- function(n, p, kk) {#
  cop <- claytonCopula(param = kk, dim = p)#
  mues <- aplicar_C2S(rCopula(n, cop))#
  while (anyNA(mues)) {#
    mues <- aplicar_C2S(rCopula(n, cop))#
  }#
  mues#
}#
#
muesgumbel <- function(n, p, kk) {#
  cop <- archmCopula(family = "gumbel", dim = p, param = kk)#
  mues <- aplicar_C2S(rCopula(n, cop))#
  while (anyNA(mues)) {#
    mues <- aplicar_C2S(rCopula(n, cop))#
  }#
  mues#
}#
#
n <- 50#
p <- 3#
n_pow <- 10#
alpha <- 0.05#
#
laska <- list(#
  c(.2, .5, .8, 1, 1.2), c(.5, 1, 1.5, 2),#
  c(1, 2, 3, 4), c(1, 2, 3),#
  c(.2, .4, .6, .8), c(.2, .4, .6, .8),#
  c(.5, 1, 1.5, 2), c(1.25, 1.5, 1.75, 2)#
)#
#
escenarios <- do.call(rbind, lapply(seq_along(laska), function(alte) {#
  data.frame(alte = alte, kk = laska[[alte]])#
}))#
escenarios$id <- seq_len(nrow(escenarios))#
#
# Los trabajadores escriben aquí su avance. Se crea una carpeta nueva por corrida.#
progress_dir <- file.path(#
  getwd(), paste0("progreso_potencias_", format(Sys.time(), "%Y%m%d_%H%M%S"))#
)#
dir.create(progress_dir, recursive = TRUE)#
actualizar_cada <- 5L  # Actualiza cada cinco réplicas; usar 1L para cada réplica.#
#
guardar_progreso <- function(escenario, replica, total, estado = "running") {#
  registro <- list(#
    id = escenario$id, alte = escenario$alte, kk = escenario$kk,#
    replica = replica, total = total, estado = estado, instante = Sys.time()#
  )#
  destino <- file.path(progress_dir, sprintf("escenario_%02d.rds", escenario$id))#
  temporal <- tempfile(pattern = "avance_", tmpdir = progress_dir)#
  saveRDS(registro, temporal)#
  file.rename(temporal, destino)#
  invisible(NULL)#
}#
#
simular_muestra <- function(alte, kk, n, p, mu1, mu2) {#
  if (alte == 1) {#
    return(rvmf(n, mu1, k = kk))#
  }#
  if (alte == 2) {#
    bin <- rbinom(1, n, .5)#
    return(rbind(rvmf(bin, mu1, k = kk), rvmf(n - bin, mu2, k = kk)))#
  }#
  if (alte == 3) {#
    raw_aniso <- MASS::mvrnorm(#
      n, mu = rep(0, p + 1), Sigma = diag(c(1 + kk, rep(1, p)))#
    )#
    return(raw_aniso / sqrt(rowSums(raw_aniso^2)))#
  }#
  if (alte == 4) {#
    Z <- matrix(rnorm(n * (p + 1)), n, p + 1)#
    ZZ <- cbind(Z[, p + 1] + kk * Z[, 1],#
                sapply(2:(p + 1), function(j) Z[, j - 1] + kk * Z[, j]))#
    return(ZZ / sqrt(rowSums(ZZ^2)))#
  }#
  if (alte == 5) {#
    Sigma <- matrix(kk / 5, p + 1, p + 1) + diag(1 - kk / 5, p + 1)#
    Z <- rmvnorm(n, mean = rep(0, p + 1), sigma = Sigma)#
    return(Z / sqrt(rowSums(Z^2)))#
  }#
  if (alte == 6) return(muesnorm(n, p + 1, kk / 10))#
  if (alte == 7) return(muesclay(n, p + 1, kk))#
  if (alte == 8) return(muesgumbel(n, p + 1, kk))#
  stop("Alternativa desconocida: ", alte)#
}#
#
ejecutar_escenario <- function(escenario) {#
  # Semilla específica por escenario: reproducible aunque cambie el número de núcleos.#
  set.seed(10000L + escenario$id)#
#
  alte <- escenario$alte#
  kk <- escenario$kk#
  message(sprintf("Iniciando alternativa %d, k = %s", alte, kk))#
#
  mu1 <- c(1, rep(0, p))#
  mu1 <- mu1 / sqrt(sum(mu1^2))#
  mu2 <- c(0, 1, rep(0, p - 1))#
  mu2 <- mu2 / sqrt(sum(mu2^2))#
#
  results <- matrix(NA_real_, nrow = n_pow, ncol = 8,#
                    dimnames = list(NULL, c(#
                      "Rayleigh", "Bingham", "Gine_Fn", "HR",#
                      "max", "sum", "maxp", "sump"#
                    )))#
#
  guardar_progreso(escenario, replica = 0L, total = n_pow)#
  for (i in seq_len(n_pow)) {#
    sample <- simular_muestra(alte, kk, n, p, mu1, mu2)#
#
    # n_ort = 10 al construir Y al reutilizar cada caché.#
    cach <- MuniCandS(sample, type = "US", n_sim = 500, n_mc = 500,#
                      n_ort = 10, return_cache = TRUE)$cache#
    cach2 <- MuniCandS(sample, type = "US", hmin = 2, n_sim = 500,#
                       n_mc = 500, n_ort = 10, return_cache = TRUE)$cache#
#
    results[i, 1] <- unif_test(sample, type = "Rayleigh", p_value = "MC")$p.value < alpha#
    results[i, 2] <- unif_test(sample, type = "Bingham", p_value = "MC")$p.value < alpha#
    results[i, 3] <- unif_test(sample, type = "Gine_Fn", p_value = "MC")$p.value < alpha#
    results[i, 4] <- HR.test(sample)$p.value < alpha#
    results[i, 5:6] <- MuniCandS(sample, type = "US", n_sim = 500,#
                                 n_mc = 500, n_ort = 10, cache = cach)$pvals < alpha#
    results[i, 7:8] <- MuniCandS(sample, type = "US", hmin = 2, n_sim = 500,#
                                 n_mc = 500, n_ort = 10, cache = cach2)$pvals < alpha#
#
    if (i %% actualizar_cada == 0L || i == n_pow) {#
      guardar_progreso(escenario, replica = i, total = n_pow)#
    }#
  }#
#
  guardar_progreso(escenario, replica = n_pow, total = n_pow, estado = "completed")#
  c(alte = alte, kk = kk, 100 * colMeans(results))#
}#
#
leer_progreso <- function() {#
  archivos <- list.files(progress_dir, pattern = "\\.rds$", full.names = TRUE)#
  registros <- lapply(archivos, function(archivo) {#
    tryCatch(readRDS(archivo), error = function(e) NULL)#
  })#
  Filter(Negate(is.null), registros)#
}#
#
mostrar_progreso <- function() {#
  registros <- leer_progreso()#
  terminados <- sum(vapply(registros, function(x) x$estado == "completed", logical(1)))#
  activos <- Filter(function(x) x$estado == "running", registros)#
#
  if (interactive()) cat("\014")#
  cat(sprintf("Escenarios terminados: %d/%d\n", terminados, nrow(escenarios)))#
  cat("Cada barra corresponde a un escenario que está ejecutándose.\n\n")#
#
  if (length(activos) == 0L && terminados < nrow(escenarios)) {#
    cat("Iniciando trabajadores...\n")#
  }#
  for (x in activos) {#
    ancho <- 32L#
    proporción <- x$replica / x$total#
    llenos <- round(ancho * proporción)#
    barra <- paste0(strrep("=", llenos), strrep("-", ancho - llenos))#
    cat(sprintf(#
      "Alt. %d, k = %-5s [%s] %3d/%d (%5.1f%%)\n",#
      x$alte, format(x$kk, trim = TRUE), barra, x$replica, x$total, 100 * proporción#
    ))#
  }#
  flush.console()#
}#
#
cores <- parallel::detectCores(logical = FALSE)#
if (is.na(cores) || cores < 2) cores <- parallel::detectCores()#
n_workers <- max(1L, min(nrow(escenarios), cores - 1L))#
#
cl <- parallel::makeCluster(n_workers)#
#
# Cada proceso carga los paquetes y compila el C++ una sola vez.#
parallel::clusterExport(cl, "cpp_file")#
parallel::clusterEvalQ(cl, {#
  library(Directional)#
  library(sphunif)#
  library(MASS)#
  library(Rcpp)#
  library(mvtnorm)#
  library(MuniCandS)#
  library(copula)#
  Rcpp::sourceCpp(cpp_file, env = globalenv())#
  NULL#
})#
#
parallel::clusterExport(cl, c(#
  "n", "p", "n_pow", "alpha", "evlin", "HR.test", "aplicar_C2S", "muesnorm",#
  "muesclay", "muesgumbel", "simular_muestra", "ejecutar_escenario",#
  "progress_dir", "actualizar_cada", "guardar_progreso"#
))#
#
# Distribuye escenarios dinámicamente y actualiza el panel mientras espera#
# resultados de los trabajadores.#
parLapply_progreso <- function(cl, X, FUN, ...) {#
  n_tareas <- length(X)#
  n_workers <- length(cl)#
  resultados <- vector("list", n_tareas)#
#
  if (n_tareas == 0L || n_workers == 0L) return(resultados)#
#
  argumentos <- function(i) c(list(X[[i]]), list(...))#
  enviar <- function(worker, tarea) {#
    parallel:::sendCall(cl[[worker]], FUN, argumentos(tarea), tag = tarea)#
  }#
#
  tareas_iniciales <- min(n_tareas, n_workers)#
  for (i in seq_len(tareas_iniciales)) enviar(i, i)#
#
  terminadas <- 0L#
  conexiones <- lapply(cl, function(worker) worker$con)#
  mostrar_progreso()#
  while (terminadas < n_tareas) {#
    # socketSelect permite refrescar el panel aunque ningún escenario haya terminado.#
    hay_resultado <- any(socketSelect(conexiones, timeout = 1))#
    if (!hay_resultado) {#
      mostrar_progreso()#
      next#
    }#
#
    respuesta <- parallel:::recvOneResult(cl)#
    terminadas <- terminadas + 1L#
    siguiente <- terminadas + tareas_iniciales#
    if (siguiente <= n_tareas) enviar(respuesta$node, siguiente)#
    resultados[respuesta$tag] <- list(respuesta$value)#
    mostrar_progreso()#
  }#
#
  parallel:::checkForRemoteErrors(resultados)#
}#
#
pow <- tryCatch(#
  do.call(rbind, parLapply_progreso(#
    cl, split(escenarios, seq_len(nrow(escenarios))), ejecutar_escenario#
  )),#
  finally = parallel::stopCluster(cl)#
)#
