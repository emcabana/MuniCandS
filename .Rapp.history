Rcpp::sourceCpp('/Volumes/ToshibaBlack/MuniCandS/R-package-MuniCandS/MuniCandS/src/funciones.cpp')#
evlin=function(u,f){ff=c(0,sort(f),1)#
	sf=max(which(ff<=u))#
	if(sf==length(ff))return(1) else return(((u-ff[sf])*(sf)+(ff[sf+1]-u)*(sf-1))/((ff[sf+1]-ff[sf])*(length(f)+1)))#
 }#
if (!requireNamespace('Rcpp', quietly = TRUE))install.packages('Rcpp')#
library('Rcpp')#
#
cppFunction('#
NumericVector S2Cpi(NumericVector x) {#
	int p = x.size() - 1;#
	NumericVector phi(p);#
	for (int j = 0; j < p; ++j) {#
    double denom = 1.0;#
    for (int k = 0; k < j; ++k) {#
      denom *= sin(phi[k]);#
    }#
    phi[j] = acos(x[j] / (denom == 0 ? 1.0 : denom));#
  }#
  if ( x[p] < 0 ) {#
        phi[p-1]=2*M_PI-phi[p-1];#
    } #
  return phi;#
}#
')#
#
Cpi2S=function(Phi){#
	Phi=c(Phi,0)#
	Z=cos(Phi[1])#
	for(j in 2:(length(Phi)))Z=c(Z,cos(Phi[j])*prod(sin(Phi[1:(j-1)])))#
	return(Z)#
}#
#
cppFunction('#
NumericVector Cpi2C(NumericVector phi) {#
  int p = phi.size();#
  NumericVector u(p);#
#
  for (int j = 0; j < p - 1; ++j) {#
    // Compute I_j(phi_j) and normalize#
    double num = 0.0, denom = 0.0;#
    int N = 1000;#
    double h = M_PI / N;#
    for (int i = 0; i <= N; ++i) {#
      double t = i * h;#
      double w = (i == 0 || i == N) ? 0.5 : 1.0;#
      double f = pow(sin(t), p - j - 1);#
      if (t <= phi[j]) num += w * f;#
      denom += w * f;#
    }#
    u[j] = h * num / (h * denom);#
  }#
#
  // Final coordinate: φ_p / (2π)#
  u[p - 1] = phi[p - 1] / (2.0 * M_PI);#
#
  return u;#
}#
')#
#
U6=c()#
for(phi in seq(0,pi,length.out=1000*pi))U6=rbind(U6,Cpi2C(c(rep(phi,5),2*phi)))#
C2Cpi=function(U){#
	p=length(U)#
	if(p>6)print('La dimensión no debe ser mayor que 6')#
	phi=c()#
	for (i in 1:p)phi=c(phi,max(which(U6[,6-p+i]<=U[i]))/1000)#
	phi[p]=2*phi[p]#
	return(phi)#
}#
#
C2S=function(U){#
	n=nrow(U)#
	Z=c()#
	for(i in 1:n)Z=rbind(Z,Cpi2S(C2Cpi(U[i,])))#
	return(Z)#
}#
#
S2C=function(Z){#
	if(is.matrix(Z)==TRUE) n=nrow(Z) else n=1#
	if(n==1)U=Cpi2C(S2Cpi(Z)) else {#
	U=c()#
	for(i in 1:n)U=rbind(U,Cpi2C(S2Cpi(Z[i,])))}#
	return(U)#
}#
library(parallel)#
#
if (!requireNamespace('pbmcapply', quietly = TRUE))install.packages('pbmcapply')#
library('pbmcapply')#
#
altNMix=function(n,p,pr,mu,Sigma){Bi=rbinom(n,1,pr)#
	return(diag(1-Bi)%*%rmvnorm(n,rep(0,p),diag(p))+diag(Bi)%*%rmvnorm(n,rep(mu,p),Sigma))#
	}#
#
B=function(p,a)matrix(a,p,p)+(1-a)*diag(p)#
#
BB=function(p,a)diag(p)+a*cbind(rep(0,p),rbind(diag(p-1),rep(0,p-1)))#
#
nordia=function(n,p,a)matrix(rnorm(n*p),n,p)%*%BB(p,a)#
#
afin=function(n,p,a)rmvnorm(n,rep(0,p),sigma=B(p,a))#
#
muesnormN=function(n,p,rho){mues=c()#
	for(i in 1:n)mues=rbind(mues,qnorm(rCopula(1,normalCopula(rho,p))))#
	return(mues)#
}#
muesclayN=function(n,p,kk){#
	copula_clayton <- claytonCopula(param = kk, dim = p)#
	mues <- rCopula(n, copula_clayton)#
	return(mues)#
}#
#
muesgumbelN=function(n,p,kk){#
	copula_gumbel <- gumbelCopula(param = kk, dim = p)#
	mues <- rCopula(n, copula_gumbel)#
	return(mues)#
}#
calpowI_parallel<-function(n, p, alte, n_sim, cores=parallelly::availableCores() - 1) {#
#
one_repI <- function(i) {#
  muestra <- switch(alte,#
    nordia(n,p,.5),#
    nordia(n,p,1),#
    nordia(n,p,1.5),#
    nordia(n,p,2),#
    nordia(n,p,2.5),#
    nordia(n,p,3),#
    afin(n,p,.2),#
    afin(n,p,.3),#
    afin(n,p,.4),#
    afin(n,p,.5),#
    afin(n,p,.6),#
    afin(n,p,.7),#
    afin(n,p,.8),#
#    muesclayN(n,p,.5),#
#    muesclayN(n,p,1),#
#    muesclayN(n,p,1.5),#
#    muesclayN(n,p,2),#
#    muesclayN(n,p,2.5),#
#   muesgumbelN(n,p,1),#
#    muesgumbelN(n,p,2),#
#   muesgumbelN(n,p,3),#
#    muesgumbelN(n,p,4),#
    matrix(rnorm(n*p),n,p)#
  )#
  # Silenciar todo lo que impriman las funciones internas#
  invisible(capture.output({#
    muestrac=muestra-colMeans(muestra)#
#    tb=test_baringhaus(muestra)#
#    th=test_hhm(muestra)#
    ret <- c(#
  #    tb$pval_asin<.05,#
  #    tb$pval_boot<.05,#
  #    tb$pval_cond<.05,#
  #    baringhaus.test(muestrac)$p.value<.05,#
  #    th$pval_boot<.05,#
  #    th$pval_cond<.05,#
  #    hhm.test(muestrac)$p.value<.05,#
#  test_spherical_BG(muestra)$p.value<.05, reemplazado por:#
	spherical_symmetry_test(muestra, B = 500)$p.value < .05,#
      MuniCandS(muestrac,type='I',n_sim=500,n_mc=500)$pvals < c(.05,.05),#
      MuniCandS(muestrac,type='I',hmin=2,n_sim=500,n_mc=500)$pvals < c(.05,.05)#
    )#
  }))#
  return(ret)#
}#
