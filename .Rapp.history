#  test_spherical_BG(muestra)$p.value<.05, reemplazado por:#
	spherical_symmetry_test(muestra, B = 500)$p.value < .05,#
      MuniCandS(muestrac,type='I',n_sim=500,n_mc=500,cache=res1$cache)$pvals < c(.05,.05),#
      MuniCandS(muestrac,type='I',hmin=2,n_sim=500,n_mc=500,cache=res2$cache)$pvals < c(.05,.05)#
    )#
  }))#
  return(ret)#
}
