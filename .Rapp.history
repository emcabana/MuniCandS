  RNGkind("L'Ecuyer-CMRG")#
  set.seed(123)#
  res <- pbmclapply(1:n_sim, one_repI, mc.cores = cores)#
  res <- do.call(rbind, res)#
  return(100 * colMeans(res))#
}#
