mat2tab <- function(mat, decimals = 1) {#
  if (!is.matrix(mat) || !is.numeric(mat)) {#
    stop("El argumento debe ser una matriz numérica.")#
  }#
  ncols <- ncol(mat)#
  # Primera columna centrada, las demás a la derecha#
  col_align <- paste0("c ", paste(rep("r", ncols - 1), collapse = " "))#
  latex_code <- paste0("\\begin{tabular}{", col_align, "}\n")#
  for (i in 1:nrow(mat)) {#
    # Formatear cada número con el mismo número de decimales#
    row_values <- paste(sprintf(paste0("%.", decimals, "f"), mat[i, ]), collapse = " & ")#
    latex_code <- paste0(latex_code, row_values, " \\\\\n")#
  }#
  latex_code <- paste0(latex_code, "\\end{tabular}")#
  return(latex_code)#
}
# ============================================================#
#  Spherical symmetry test of Banerjee & Ghosh (2024)#
# ============================================================#
#
# ------------------------------------------------------------#
# Generate random points uniformly on the unit sphere S^{d-1}#
# ------------------------------------------------------------#
runif_sphere <- function(n, d)#
{#
  Z <- matrix(rnorm(n * d), nrow = n, ncol = d)#
  norms <- sqrt(rowSums(Z^2))#
  Z / norms#
}#
#
# ------------------------------------------------------------#
# Gaussian kernel used in the paper#
# K(x,y) = exp( -||x-y||^2 / (2d) )#
# ------------------------------------------------------------#
gaussian_kernel <- function(x, y)#
{#
  d <- length(x)#
  exp(-sum((x - y)^2) / (2 * d))#
}#
#
# ------------------------------------------------------------#
# Compute omega_hat#
# ------------------------------------------------------------#
omega_hat_stat <- function(X, Xt)#
{#
  n <- nrow(X)#
#
  total <- 0#
#
  for(i in 1:(n-1))#
  {#
    for(j in (i+1):n)#
    {#
      total <- total +#
        gaussian_kernel(X[i, ],  X[j, ]) +#
        gaussian_kernel(Xt[i, ], Xt[j, ]) -#
        gaussian_kernel(X[i, ],  Xt[j, ]) -#
        gaussian_kernel(X[j, ],  Xt[i, ])#
    }#
  }#
#
  total / choose(n, 2)#
}#
#
# ------------------------------------------------------------#
# Main test function#
# ------------------------------------------------------------#
# X : data matrix (n x d)#
# B : Monte Carlo repetitions for resampling calibration#
# seed : optional random seed#
# ------------------------------------------------------------#
spherical_symmetry_test <- function(X,#
                                    B = 500,#
                                    seed = NULL)#
{#
  if(!is.null(seed))#
    set.seed(seed)#
#
  X <- as.matrix(X)#
#
  n <- nrow(X)#
  d <- ncol(X)#
#
  # ----------------------------------------------------------#
  # Step 1: data augmentation#
  # ----------------------------------------------------------#
#
  norms <- sqrt(rowSums(X^2))#
#
  U <- runif_sphere(n, d)#
#
  Xt <- U * norms#
#
  # ----------------------------------------------------------#
  # Step 2: observed statistic#
  # ----------------------------------------------------------#
#
  omega_obs <- omega_hat_stat(X, Xt)#
#
  # ----------------------------------------------------------#
  # Step 3: randomized resampling algorithm#
  # ----------------------------------------------------------#
#
  omega_perm <- numeric(B)#
#
  for(b in 1:B)#
  {#
    rho <- rbinom(n, 1, 0.5)#
#
    Y  <- X#
    Yt <- Xt#
#
    swap <- which(rho == 0)#
#
    if(length(swap) > 0)#
    {#
      Y[swap, ]  <- Xt[swap, ]#
      Yt[swap, ] <- X[swap, ]#
    }#
#
    omega_perm[b] <- omega_hat_stat(Y, Yt)#
  }#
#
  # Monte Carlo p-value#
  pvalue <- (sum(omega_perm >= omega_obs) + 1) / (B + 1)#
#
  list(#
    statistic = omega_obs,#
    p.value = pvalue,#
    permuted_statistics = omega_perm,#
    method = paste(#
      "Banerjee-Ghosh spherical symmetry test",#
      "(randomized resampling version)"#
    ),#
    data.name = deparse(substitute(X)),#
    n = n,#
    d = d#
  )#
}#
#
# ------------------------------------------------------------#
# Print method#
# ------------------------------------------------------------#
print.spherical_test <- function(x, ...)#
{#
  cat("\n")#
  cat(x$method, "\n")#
  cat("----------------------------------------\n")#
  cat("Sample size n =", x$n, "\n")#
  cat("Dimension d  =", x$d, "\n")#
  cat("Statistic     =", signif(x$statistic, 6), "\n")#
  cat("p-value       =", signif(x$p.value, 6), "\n")#
  cat("\n")#
}#
