}#
save(file=paste('powers','type_n=',as.character(n),'_p=',as.character(p),sep=''),pow)#
}#
save(file=paste('powers','type_n=',as.character(n),'_p=',as.character(p),sep=''),pow)
library(Directional)#
library(sphunif)#
library(MASS)#
library(Rcpp)#
library(mvtnorm)#
library(Rfast)#
#
library(MuniCandS)#
#
nn=c(50,100)#
#
Rcpp::sourceCpp('~/MuniCandS/src/funciones.cpp')#
evlin=function(u,f){ff=c(0,sort(f),1)#
	sf=max(which(ff<=u))#
	if(sf==length(ff))return(1) else return(((u-ff[sf])*(sf)+(ff[sf+1]-u)*(sf-1))/((ff[sf+1]-ff[sf])*(length(f)+1)))#
 }#
# Código para la prueba HR, por no estar en spunif ni en otro paquete#
HR.test <- function(x, B = 500) {#
  # x: matriz n x p de vectores unitarios#
  n <- nrow(x)#
  p <- ncol(x)#
  # Estadística observada: suma de cosenos entre pares#
  theta <- acos(pmin(pmax(x %*% t(x), -1), 1))  # matriz de ángulos#
  stat_obs <- sum(cos(theta[lower.tri(theta)]))#
  # Bootstrap bajo H0: datos uniformes en la esfera#
  stat_boot <- numeric(B)#
  for (b in 1:B) {#
    u <- matrix(rnorm(n * p), n, p)#
    u <- u / sqrt(rowSums(u^2))#
    theta_b <- acos(pmin(pmax(u %*% t(u), -1), 1))#
    stat_boot[b] <- sum(cos(theta_b[lower.tri(theta_b)]))#
  }#
  pval <- mean(stat_boot >= stat_obs)#
  list(statistic = stat_obs, p.value = pval)#
}#
#
library(copula)#
#
C2Cpi=function(U){#
	p=length(U)#
	if(p>6)print('La dimensión no debe ser mayor que 6')#
	phi=c()#
	for (i in 1:p)phi=c(phi,max(which(U6[,6-p+i]<=U[i]))/1000)#
	phi[p]=2*phi[p]#
	return(phi)#
}#
#
C2S=function(U){#
	n=nrow(U)#
	Z=c()#
	for(i in 1:n)Z=rbind(Z,Cpi2S(C2Cpi(U[i,])))#
	return(Z)#
}#
#
S2C=function(Z){#
	if(is.matrix(Z)==TRUE) n=nrow(Z) else n=1#
	if(n==1)U=Cpi2C(S2Cpi(Z)) else {#
	U=c()#
	for(i in 1:n)U=rbind(U,Cpi2C(S2Cpi(Z[i,])))}#
	return(U)#
}#
muesnorm=function(n,p,rho){mues=c()#
	for(i in 1:n)mues=rbind(mues,C2S(rCopula(1,normalCopula(rho,p))))#
	return(mues)#
	}#
muesclay=function(n,p,kk){mues=c()#
	for(i in 1:n){mu=tra(rCopula(n, claytonCopula(param = kk, dim = p)))#
		while(is.na(sum(mu)))mu=C2S(rCopula(n, claytonCopula(param = kk, dim = p)))#
		mues=rbind(mues,mu)}#
	return(mues)#
}#
muesgumbel=function(n,p,kk){mues=c()#
	for(i in 1:n){mu=C2S(rCopula(n,archmCopula(family = "gumbel", dim = p, param = kk)))#
		while(is.na(sum(mu)))mu=tra(rCopula(n,archmCopula(family = "gumbel", dim = p, param = kk)))#
		mues=rbind(mues,mu)}#
	return(mues)#
}#
n <- 50#
p <- 3#
#
pow=matrix(NA,1,11)#
#
#load(file=paste('powers','type_n=',as.character(n),'_p=',as.character(p),sep=''))#
#
laska=list(c(.2,.5,.8,1,1.2),c(.5,1,1.5,2),c(1,2,3,4),c(1,2,3),c(.2,.4,.6,.8),c(.2,.4,.6,.8),c(.5,1,1.5,2),c(1.25,1.5,1.75,2))#
#
for(alte in 1:8){#
for(kk in laska[[alte]]){#
#
print(c(alte,kk))#
#
# Definiciones de las alternativas#
#
# 1. VMF con concentración#
mu1 <- c(1, rep(0, p))#
mu1 <- mu1 / sqrt(sum(mu1^2))#
alt_vmf <- rvmf(n, mu1, k = kk)#
#
# 2. Mezcla de VMF#
mu1 <- c(1, rep(0, p))#
mu1 <- mu1 / sqrt(sum(mu1^2))#
mu2 <- c(0, 1, rep(0, p - 1))#
mu2 <- mu2 / sqrt(sum(mu2^2))#
bin=rbinom(1,n,.5)#
alt_mix <- rbind(rvmf(bin, mu1, k = kk), rvmf(n-bin, mu2, k = kk))#
#
# 3. Proyección de normal anisotrópica#
Sigma <- diag(c(1+kk, rep(1, p)))#
raw_aniso <- MASS::mvrnorm(n, mu = rep(0, p+1), Sigma = Sigma)#
alt_aniso <- raw_aniso / sqrt(rowSums(raw_aniso^2))#
#
# 4. Proyección de cópula normal#
Z <- matrix(rnorm(n*(p+1)),n,p+1)#
ZZ <-Z[,p+1]+kk*Z[,1]#
for(i in 1:(p))ZZ<-cbind(Z[,i]+kk*Z[,i+1])#
alt_copula <- ZZ/sqrt(rowSums(ZZ^2))#
#
# 5. Proyección de normales rho-correlacionadas#
Sigma=matrix(rep(kk/10,(p+1)^2),p+1,p+1)+diag(rep(1-kk/10,p+1))#
Z=rmvnorm(n,mu=rep(0,p+1),sigma=Sigma)#
sample=Z/sqrt(rowSums(Z^2))#
#
n_pow=50#
#
results <- matrix(NA, nrow = n_pow, ncol = 8)#
colnames(results) <- c("Rayleigh", "Bingham", "Giné Fn","HR","max","sum","maxp","sump")#
set.seed(123)#
for (i in 1:n_pow) {if(i==10*floor(i/10)){#
		lines(i,i,type='p')#
		 Sys.sleep(0.01)       # Pausa para que se vea el punto#
  				flush.console()}       # Asegura que se actualice la consola#
if(alte==1)  sample <- rvmf(n, mu1, k = kk)  # alternativa fija#
if(alte==2) {bin=rbinom(1,n,.5)#
	sample <- rbind(rvmf(bin, mu1, k = kk), rvmf(n-bin, mu2, k = kk))}#
if(alte==3){ raw_aniso <- MASS::mvrnorm(n, mu = rep(0, p+1), Sigma = diag(c(1+kk, rep(1, p))))#
 sample <- raw_aniso / sqrt(rowSums(raw_aniso^2))}#
if(alte==4){Z <- matrix(rnorm(n*(p+1)),n,p+1)#
ZZ <-Z[,p+1]+kk*Z[,1]#
for (ij in 2:(p+1))ZZ=cbind(ZZ,Z[,ij-1]+kk*Z[,ij])#
sample <- ZZ/sqrt(rowSums(ZZ^2))}#
if(alte==5){Sigma <- matrix(rep(kk/5,(p+1)^2),p+1,p+1)+diag(rep(1-kk/5,p+1))#
Z <- rmvnorm(n,mu=rep(0,p+1),sigma=Sigma)#
sample <- Z/sqrt(rowSums(Z^2))}#
#
if(alte==6){sample=muesnorm(n,p+1,kk/10)}#
if(alte==7){sample=muesclay(n,p+1,kk)}#
if(alte==8){sample=muesgumbel(n,p+1,kk)}#
cach=MuniCandS(sample,type='US',n_sim=500,n_mc=500,n_ort=50,return_cache=TRUE)$cache#
cach2=MuniCandS(sample,type='US',hmin=2,n_sim=500,n_mc=500,n_ort=50,return_cache=TRUE)$cache#
 results[i, 1] <- unif_test(sample, type="Rayleigh",p_value="MC")$p.value < 0.05#
 results[i, 2] <-  unif_test(sample, type="Bingham",p_value="MC")$p.value < 0.05#
 #results[i, 3] <-  unif_test(sample, type="Sobolev",p_value="MC")$p.value < 0.05#
 results[i, 3] <-  unif_test(sample, type="Gine_Fn",p_value="MC")$p.value < 0.05#
 results[i, 4] <- HR.test(sample)$p.value < 0.05#
 results[i,5:6] <- MuniCandS(sample,type='US',n_sim=500,n_mc=500,n_ort=50,cache=cach)$pvals<c(.05,.05)#
 results[i,7:8] <- MuniCandS(sample,type='US',hmin=2,n_sim=500,n_mc=500,n_ort=50,cache=cach2)$pvals<c(.05,.05)#
}#
#
# Estimar potencia#
#
pow=rbind(pow,c(alte,kk,100*colMeans(results)))#
#
}#
save(file=paste('powers','type_n=',as.character(n),'_p=',as.character(p),sep=''),pow)#
}#
save(file=paste('powers','type_n=',as.character(n),'_p=',as.character(p),sep=''),pow)
# Estimación paralela de potencias para MuniCandS#
# Cada escenario (alternativa, parámetro) se ejecuta en un proceso independiente.#
#
library(Directional)#
library(sphunif)#
library(MASS)#
library(Rcpp)#
library(mvtnorm)#
library(MuniCandS)#
library(copula)#
library(parallel)#
#
# Ajustar si el archivo C++ se encuentra en otra ubicación.#
cpp_file <- path.expand("~/MuniCandS/src/funciones.cpp")#
if (!file.exists(cpp_file)) {#
  stop("No se encontró el archivo C++: ", cpp_file)#
}#
Rcpp::sourceCpp(cpp_file)#
#
evlin <- function(u, f) {#
  ff <- c(0, sort(f), 1)#
  sf <- max(which(ff <= u))#
  if (sf == length(ff)) {#
    return(1)#
  }#
  ((u - ff[sf]) * sf + (ff[sf + 1] - u) * (sf - 1)) /#
    ((ff[sf + 1] - ff[sf]) * (length(f) + 1))#
}#
#
HR.test <- function(x, B = 500) {#
  n <- nrow(x)#
  p <- ncol(x)#
#
  theta <- acos(pmin(pmax(x %*% t(x), -1), 1))#
  stat_obs <- sum(cos(theta[lower.tri(theta)]))#
#
  stat_boot <- numeric(B)#
  for (b in seq_len(B)) {#
    u <- matrix(rnorm(n * p), n, p)#
    u <- u / sqrt(rowSums(u^2))#
    theta_b <- acos(pmin(pmax(u %*% t(u), -1), 1))#
    stat_boot[b] <- sum(cos(theta_b[lower.tri(theta_b)]))#
  }#
#
  list(statistic = stat_obs, p.value = mean(stat_boot >= stat_obs))#
}#
#
C2Cpi=function(U){#
	p=length(U)#
	if(p>6)print('La dimensión no debe ser mayor que 6')#
	phi=c()#
	for (i in 1:p)phi=c(phi,max(which(U6[,6-p+i]<=U[i]))/1000)#
	phi[p]=2*phi[p]#
	return(phi)#
}#
#
C2S=function(U){#
	n=nrow(U)#
	Z=c()#
	for(i in 1:n)Z=rbind(Z,Cpi2S(C2Cpi(U[i,])))#
	return(Z)#
}#
#
S2C=function(Z){#
	if(is.matrix(Z)==TRUE) n=nrow(Z) else n=1#
	if(n==1)U=Cpi2C(S2Cpi(Z)) else {#
	U=c()#
	for(i in 1:n)U=rbind(U,Cpi2C(S2Cpi(Z[i,])))}#
	return(U)#
}#
muesnorm <- function(n, p, rho) {#
  mues <- do.call(rbind, lapply(seq_len(n), function(i) {#
    C2S(rCopula(1, normalCopula(rho, p)))#
  }))#
  mues#
}#
#
# Ambas funciones generan una muestra de tamaño n (no n^2).#
muesclay <- function(n, p, kk) {#
  cop <- claytonCopula(param = kk, dim = p)#
  mues <- C2S(rCopula(n, cop))#
  while (anyNA(mues)) {#
    mues <- C2S(rCopula(n, cop))#
  }#
  mues#
}#
#
muesgumbel <- function(n, p, kk) {#
  cop <- archmCopula(family = "gumbel", dim = p, param = kk)#
  mues <- C2S(rCopula(n, cop))#
  while (anyNA(mues)) {#
    mues <- C2S(rCopula(n, cop))#
  }#
  mues#
}#
#
n <- 50#
p <- 3#
n_pow <- 500#
alpha <- 0.05#
#
laska <- list(#
  c(.2, .5, .8, 1, 1.2), c(.5, 1, 1.5, 2),#
  c(1, 2, 3, 4), c(1, 2, 3),#
  c(.2, .4, .6, .8), c(.2, .4, .6, .8),#
  c(.5, 1, 1.5, 2), c(1.25, 1.5, 1.75, 2)#
)#
#
escenarios <- do.call(rbind, lapply(seq_along(laska), function(alte) {#
  data.frame(alte = alte, kk = laska[[alte]])#
}))#
escenarios$id <- seq_len(nrow(escenarios))#
#
# Los trabajadores escriben aquí su avance. Se crea una carpeta nueva por corrida.#
progress_dir <- file.path(#
  getwd(), paste0("progreso_potencias_", format(Sys.time(), "%Y%m%d_%H%M%S"))#
)#
dir.create(progress_dir, recursive = TRUE)#
actualizar_cada <- 5L  # Actualiza cada cinco réplicas; usar 1L para cada réplica.#
#
guardar_progreso <- function(escenario, replica, total, estado = "running") {#
  registro <- list(#
    id = escenario$id, alte = escenario$alte, kk = escenario$kk,#
    replica = replica, total = total, estado = estado, instante = Sys.time()#
  )#
  destino <- file.path(progress_dir, sprintf("escenario_%02d.rds", escenario$id))#
  temporal <- tempfile(pattern = "avance_", tmpdir = progress_dir)#
  saveRDS(registro, temporal)#
  file.rename(temporal, destino)#
  invisible(NULL)#
}#
#
simular_muestra <- function(alte, kk, n, p, mu1, mu2) {#
  if (alte == 1) {#
    return(rvmf(n, mu1, k = kk))#
  }#
  if (alte == 2) {#
    bin <- rbinom(1, n, .5)#
    return(rbind(rvmf(bin, mu1, k = kk), rvmf(n - bin, mu2, k = kk)))#
  }#
  if (alte == 3) {#
    raw_aniso <- MASS::mvrnorm(#
      n, mu = rep(0, p + 1), Sigma = diag(c(1 + kk, rep(1, p)))#
    )#
    return(raw_aniso / sqrt(rowSums(raw_aniso^2)))#
  }#
  if (alte == 4) {#
    Z <- matrix(rnorm(n * (p + 1)), n, p + 1)#
    ZZ <- cbind(Z[, p + 1] + kk * Z[, 1],#
                sapply(2:(p + 1), function(j) Z[, j - 1] + kk * Z[, j]))#
    return(ZZ / sqrt(rowSums(ZZ^2)))#
  }#
  if (alte == 5) {#
    Sigma <- matrix(kk / 5, p + 1, p + 1) + diag(1 - kk / 5, p + 1)#
    Z <- rmvnorm(n, mean = rep(0, p + 1), sigma = Sigma)#
    return(Z / sqrt(rowSums(Z^2)))#
  }#
  if (alte == 6) return(muesnorm(n, p + 1, kk / 10))#
  if (alte == 7) return(muesclay(n, p + 1, kk))#
  if (alte == 8) return(muesgumbel(n, p + 1, kk))#
  stop("Alternativa desconocida: ", alte)#
}#
#
ejecutar_escenario <- function(escenario) {#
  # Semilla específica por escenario: reproducible aunque cambie el número de núcleos.#
  set.seed(10000L + escenario$id)#
#
  alte <- escenario$alte#
  kk <- escenario$kk#
  message(sprintf("Iniciando alternativa %d, k = %s", alte, kk))#
#
  mu1 <- c(1, rep(0, p))#
  mu1 <- mu1 / sqrt(sum(mu1^2))#
  mu2 <- c(0, 1, rep(0, p - 1))#
  mu2 <- mu2 / sqrt(sum(mu2^2))#
#
  results <- matrix(NA_real_, nrow = n_pow, ncol = 8,#
                    dimnames = list(NULL, c(#
                      "Rayleigh", "Bingham", "Gine_Fn", "HR",#
                      "max", "sum", "maxp", "sump"#
                    )))#
#
  guardar_progreso(escenario, replica = 0L, total = n_pow)#
  for (i in seq_len(n_pow)) {#
    sample <- simular_muestra(alte, kk, n, p, mu1, mu2)#
#
    # n_ort = 10 al construir Y al reutilizar cada caché.#
    cach <- MuniCandS(sample, type = "US", n_sim = 500, n_mc = 500,#
                      n_ort = 10, return_cache = TRUE)$cache#
    cach2 <- MuniCandS(sample, type = "US", hmin = 2, n_sim = 500,#
                       n_mc = 500, n_ort = 10, return_cache = TRUE)$cache#
#
    results[i, 1] <- unif_test(sample, type = "Rayleigh", p_value = "MC")$p.value < alpha#
    results[i, 2] <- unif_test(sample, type = "Bingham", p_value = "MC")$p.value < alpha#
    results[i, 3] <- unif_test(sample, type = "Gine_Fn", p_value = "MC")$p.value < alpha#
    results[i, 4] <- HR.test(sample)$p.value < alpha#
    results[i, 5:6] <- MuniCandS(sample, type = "US", n_sim = 500,#
                                 n_mc = 500, n_ort = 10, cache = cach)$pvals < alpha#
    results[i, 7:8] <- MuniCandS(sample, type = "US", hmin = 2, n_sim = 500,#
                                 n_mc = 500, n_ort = 10, cache = cach2)$pvals < alpha#
#
    if (i %% actualizar_cada == 0L || i == n_pow) {#
      guardar_progreso(escenario, replica = i, total = n_pow)#
    }#
  }#
#
  guardar_progreso(escenario, replica = n_pow, total = n_pow, estado = "completed")#
  c(alte = alte, kk = kk, 100 * colMeans(results))#
}#
#
leer_progreso <- function() {#
  archivos <- list.files(progress_dir, pattern = "\\.rds$", full.names = TRUE)#
  registros <- lapply(archivos, function(archivo) {#
    tryCatch(readRDS(archivo), error = function(e) NULL)#
  })#
  Filter(Negate(is.null), registros)#
}#
#
mostrar_progreso <- function() {#
  registros <- leer_progreso()#
  terminados <- sum(vapply(registros, function(x) x$estado == "completed", logical(1)))#
  activos <- Filter(function(x) x$estado == "running", registros)#
#
  if (interactive()) cat("\014")#
  cat(sprintf("Escenarios terminados: %d/%d\n", terminados, nrow(escenarios)))#
  cat("Cada barra corresponde a un escenario que está ejecutándose.\n\n")#
#
  if (length(activos) == 0L && terminados < nrow(escenarios)) {#
    cat("Iniciando trabajadores...\n")#
  }#
  for (x in activos) {#
    ancho <- 32L#
    proporción <- x$replica / x$total#
    llenos <- round(ancho * proporción)#
    barra <- paste0(strrep("=", llenos), strrep("-", ancho - llenos))#
    cat(sprintf(#
      "Alt. %d, k = %-5s [%s] %3d/%d (%5.1f%%)\n",#
      x$alte, format(x$kk, trim = TRUE), barra, x$replica, x$total, 100 * proporción#
    ))#
  }#
  flush.console()#
}#
#
cores <- parallel::detectCores(logical = FALSE)#
if (is.na(cores) || cores < 2) cores <- parallel::detectCores()#
n_workers <- max(1L, min(nrow(escenarios), cores - 1L))#
#
cl <- parallel::makeCluster(n_workers)#
#
# Cada proceso carga los paquetes y compila el C++ una sola vez.#
parallel::clusterExport(cl, "cpp_file")#
parallel::clusterEvalQ(cl, {#
  library(Directional)#
  library(sphunif)#
  library(MASS)#
  library(Rcpp)#
  library(mvtnorm)#
  library(MuniCandS)#
  library(copula)#
  Rcpp::sourceCpp(cpp_file)#
  NULL#
})#
#
parallel::clusterExport(cl, c(#
  "n", "p", "n_pow", "alpha", "evlin", "HR.test", "muesnorm",#
  "muesclay", "muesgumbel", "simular_muestra", "ejecutar_escenario",#
  "progress_dir", "actualizar_cada", "guardar_progreso"#
))#
#
# Distribuye escenarios dinámicamente y actualiza el panel mientras espera#
# resultados de los trabajadores.#
parLapply_progreso <- function(cl, X, FUN, ...) {#
  n_tareas <- length(X)#
  n_workers <- length(cl)#
  resultados <- vector("list", n_tareas)#
#
  if (n_tareas == 0L || n_workers == 0L) return(resultados)#
#
  argumentos <- function(i) c(list(X[[i]]), list(...))#
  enviar <- function(worker, tarea) {#
    parallel:::sendCall(cl[[worker]], FUN, argumentos(tarea), tag = tarea)#
  }#
#
  tareas_iniciales <- min(n_tareas, n_workers)#
  for (i in seq_len(tareas_iniciales)) enviar(i, i)#
#
  terminadas <- 0L#
  conexiones <- lapply(cl, function(worker) worker$con)#
  mostrar_progreso()#
  while (terminadas < n_tareas) {#
    # socketSelect permite refrescar el panel aunque ningún escenario haya terminado.#
    hay_resultado <- any(socketSelect(conexiones, timeout = 1))#
    if (!hay_resultado) {#
      mostrar_progreso()#
      next#
    }#
#
    respuesta <- parallel:::recvOneResult(cl)#
    terminadas <- terminadas + 1L#
    siguiente <- terminadas + tareas_iniciales#
    if (siguiente <= n_tareas) enviar(respuesta$node, siguiente)#
    resultados[respuesta$tag] <- list(respuesta$value)#
    mostrar_progreso()#
  }#
#
  parallel:::checkForRemoteErrors(resultados)#
}#
#
pow <- tryCatch(#
  do.call(rbind, parLapply_progreso(#
    cl, split(escenarios, seq_len(nrow(escenarios))), ejecutar_escenario#
  )),#
  finally = parallel::stopCluster(cl)#
)#
#
output_file <- sprintf("powers_type_n=%d_p=%d.RData", n, p)#
save(pow, file = output_file)#
write.csv(pow, sprintf("powers_type_n=%d_p=%d.csv", n, p), row.names = FALSE)#
#
print(pow)#
message("Los archivos de avance de esta corrida quedaron en: ", progress_dir)
# Estimación paralela de potencias para MuniCandS#
# Cada escenario (alternativa, parámetro) se ejecuta en un proceso independiente.#
#
library(Directional)#
library(sphunif)#
library(MASS)#
library(Rcpp)#
library(mvtnorm)#
library(MuniCandS)#
library(copula)#
library(parallel)#
#
# Ajustar si el archivo C++ se encuentra en otra ubicación.#
cpp_file <- path.expand("~/MuniCandS/src/funciones.cpp")#
if (!file.exists(cpp_file)) {#
  stop("No se encontró el archivo C++: ", cpp_file)#
}#
Rcpp::sourceCpp(cpp_file)#
#
evlin <- function(u, f) {#
  ff <- c(0, sort(f), 1)#
  sf <- max(which(ff <= u))#
  if (sf == length(ff)) {#
    return(1)#
  }#
  ((u - ff[sf]) * sf + (ff[sf + 1] - u) * (sf - 1)) /#
    ((ff[sf + 1] - ff[sf]) * (length(f) + 1))#
}#
#
HR.test <- function(x, B = 500) {#
  n <- nrow(x)#
  p <- ncol(x)#
#
  theta <- acos(pmin(pmax(x %*% t(x), -1), 1))#
  stat_obs <- sum(cos(theta[lower.tri(theta)]))#
#
  stat_boot <- numeric(B)#
  for (b in seq_len(B)) {#
    u <- matrix(rnorm(n * p), n, p)#
    u <- u / sqrt(rowSums(u^2))#
    theta_b <- acos(pmin(pmax(u %*% t(u), -1), 1))#
    stat_boot[b] <- sum(cos(theta_b[lower.tri(theta_b)]))#
  }#
#
  list(statistic = stat_obs, p.value = mean(stat_boot >= stat_obs))#
}#
#
C2Cpi=function(U){#
	p=length(U)#
	if(p>6)print('La dimensión no debe ser mayor que 6')#
	phi=c()#
	for (i in 1:p)phi=c(phi,max(which(U6[,6-p+i]<=U[i]))/1000)#
	phi[p]=2*phi[p]#
	return(phi)#
}#
#
C2S=function(U){#
	n=nrow(U)#
	Z=c()#
	for(i in 1:n)Z=rbind(Z,Cpi2S(C2Cpi(U[i,])))#
	return(Z)#
}#
#
S2C=function(Z){#
	if(is.matrix(Z)==TRUE) n=nrow(Z) else n=1#
	if(n==1)U=Cpi2C(S2Cpi(Z)) else {#
	U=c()#
	for(i in 1:n)U=rbind(U,Cpi2C(S2Cpi(Z[i,])))}#
	return(U)#
}#
muesnorm <- function(n, p, rho) {#
  mues <- do.call(rbind, lapply(seq_len(n), function(i) {#
    C2S(rCopula(1, normalCopula(rho, p)))#
  }))#
  mues#
}#
#
# Ambas funciones generan una muestra de tamaño n (no n^2).#
muesclay <- function(n, p, kk) {#
  cop <- claytonCopula(param = kk, dim = p)#
  mues <- C2S(rCopula(n, cop))#
  while (anyNA(mues)) {#
    mues <- C2S(rCopula(n, cop))#
  }#
  mues#
}#
#
muesgumbel <- function(n, p, kk) {#
  cop <- archmCopula(family = "gumbel", dim = p, param = kk)#
  mues <- C2S(rCopula(n, cop))#
  while (anyNA(mues)) {#
    mues <- C2S(rCopula(n, cop))#
  }#
  mues#
}#
#
n <- 50#
p <- 3#
n_pow <- 50#
alpha <- 0.05#
#
laska <- list(#
  c(.2, .5, .8, 1, 1.2), c(.5, 1, 1.5, 2),#
  c(1, 2, 3, 4), c(1, 2, 3),#
  c(.2, .4, .6, .8), c(.2, .4, .6, .8),#
  c(.5, 1, 1.5, 2), c(1.25, 1.5, 1.75, 2)#
)#
#
escenarios <- do.call(rbind, lapply(seq_along(laska), function(alte) {#
  data.frame(alte = alte, kk = laska[[alte]])#
}))#
escenarios$id <- seq_len(nrow(escenarios))#
#
# Los trabajadores escriben aquí su avance. Se crea una carpeta nueva por corrida.#
progress_dir <- file.path(#
  getwd(), paste0("progreso_potencias_", format(Sys.time(), "%Y%m%d_%H%M%S"))#
)#
dir.create(progress_dir, recursive = TRUE)#
actualizar_cada <- 5L  # Actualiza cada cinco réplicas; usar 1L para cada réplica.#
#
guardar_progreso <- function(escenario, replica, total, estado = "running") {#
  registro <- list(#
    id = escenario$id, alte = escenario$alte, kk = escenario$kk,#
    replica = replica, total = total, estado = estado, instante = Sys.time()#
  )#
  destino <- file.path(progress_dir, sprintf("escenario_%02d.rds", escenario$id))#
  temporal <- tempfile(pattern = "avance_", tmpdir = progress_dir)#
  saveRDS(registro, temporal)#
  file.rename(temporal, destino)#
  invisible(NULL)#
}#
#
simular_muestra <- function(alte, kk, n, p, mu1, mu2) {#
  if (alte == 1) {#
    return(rvmf(n, mu1, k = kk))#
  }#
  if (alte == 2) {#
    bin <- rbinom(1, n, .5)#
    return(rbind(rvmf(bin, mu1, k = kk), rvmf(n - bin, mu2, k = kk)))#
  }#
  if (alte == 3) {#
    raw_aniso <- MASS::mvrnorm(#
      n, mu = rep(0, p + 1), Sigma = diag(c(1 + kk, rep(1, p)))#
    )#
    return(raw_aniso / sqrt(rowSums(raw_aniso^2)))#
  }#
  if (alte == 4) {#
    Z <- matrix(rnorm(n * (p + 1)), n, p + 1)#
    ZZ <- cbind(Z[, p + 1] + kk * Z[, 1],#
                sapply(2:(p + 1), function(j) Z[, j - 1] + kk * Z[, j]))#
    return(ZZ / sqrt(rowSums(ZZ^2)))#
  }#
  if (alte == 5) {#
    Sigma <- matrix(kk / 5, p + 1, p + 1) + diag(1 - kk / 5, p + 1)#
    Z <- rmvnorm(n, mean = rep(0, p + 1), sigma = Sigma)#
    return(Z / sqrt(rowSums(Z^2)))#
  }#
  if (alte == 6) return(muesnorm(n, p + 1, kk / 10))#
  if (alte == 7) return(muesclay(n, p + 1, kk))#
  if (alte == 8) return(muesgumbel(n, p + 1, kk))#
  stop("Alternativa desconocida: ", alte)#
}#
#
ejecutar_escenario <- function(escenario) {#
  # Semilla específica por escenario: reproducible aunque cambie el número de núcleos.#
  set.seed(10000L + escenario$id)#
#
  alte <- escenario$alte#
  kk <- escenario$kk#
  message(sprintf("Iniciando alternativa %d, k = %s", alte, kk))#
#
  mu1 <- c(1, rep(0, p))#
  mu1 <- mu1 / sqrt(sum(mu1^2))#
  mu2 <- c(0, 1, rep(0, p - 1))#
  mu2 <- mu2 / sqrt(sum(mu2^2))#
#
  results <- matrix(NA_real_, nrow = n_pow, ncol = 8,#
                    dimnames = list(NULL, c(#
                      "Rayleigh", "Bingham", "Gine_Fn", "HR",#
                      "max", "sum", "maxp", "sump"#
                    )))#
#
  guardar_progreso(escenario, replica = 0L, total = n_pow)#
  for (i in seq_len(n_pow)) {#
    sample <- simular_muestra(alte, kk, n, p, mu1, mu2)#
#
    # n_ort = 10 al construir Y al reutilizar cada caché.#
    cach <- MuniCandS(sample, type = "US", n_sim = 500, n_mc = 500,#
                      n_ort = 10, return_cache = TRUE)$cache#
    cach2 <- MuniCandS(sample, type = "US", hmin = 2, n_sim = 500,#
                       n_mc = 500, n_ort = 10, return_cache = TRUE)$cache#
#
    results[i, 1] <- unif_test(sample, type = "Rayleigh", p_value = "MC")$p.value < alpha#
    results[i, 2] <- unif_test(sample, type = "Bingham", p_value = "MC")$p.value < alpha#
    results[i, 3] <- unif_test(sample, type = "Gine_Fn", p_value = "MC")$p.value < alpha#
    results[i, 4] <- HR.test(sample)$p.value < alpha#
    results[i, 5:6] <- MuniCandS(sample, type = "US", n_sim = 500,#
                                 n_mc = 500, n_ort = 10, cache = cach)$pvals < alpha#
    results[i, 7:8] <- MuniCandS(sample, type = "US", hmin = 2, n_sim = 500,#
                                 n_mc = 500, n_ort = 10, cache = cach2)$pvals < alpha#
#
    if (i %% actualizar_cada == 0L || i == n_pow) {#
      guardar_progreso(escenario, replica = i, total = n_pow)#
    }#
  }#
#
  guardar_progreso(escenario, replica = n_pow, total = n_pow, estado = "completed")#
  c(alte = alte, kk = kk, 100 * colMeans(results))#
}#
#
leer_progreso <- function() {#
  archivos <- list.files(progress_dir, pattern = "\\.rds$", full.names = TRUE)#
  registros <- lapply(archivos, function(archivo) {#
    tryCatch(readRDS(archivo), error = function(e) NULL)#
  })#
  Filter(Negate(is.null), registros)#
}#
#
mostrar_progreso <- function() {#
  registros <- leer_progreso()#
  terminados <- sum(vapply(registros, function(x) x$estado == "completed", logical(1)))#
  activos <- Filter(function(x) x$estado == "running", registros)#
#
  if (interactive()) cat("\014")#
  cat(sprintf("Escenarios terminados: %d/%d\n", terminados, nrow(escenarios)))#
  cat("Cada barra corresponde a un escenario que está ejecutándose.\n\n")#
#
  if (length(activos) == 0L && terminados < nrow(escenarios)) {#
    cat("Iniciando trabajadores...\n")#
  }#
  for (x in activos) {#
    ancho <- 32L#
    proporción <- x$replica / x$total#
    llenos <- round(ancho * proporción)#
    barra <- paste0(strrep("=", llenos), strrep("-", ancho - llenos))#
    cat(sprintf(#
      "Alt. %d, k = %-5s [%s] %3d/%d (%5.1f%%)\n",#
      x$alte, format(x$kk, trim = TRUE), barra, x$replica, x$total, 100 * proporción#
    ))#
  }#
  flush.console()#
}#
#
cores <- parallel::detectCores(logical = FALSE)#
if (is.na(cores) || cores < 2) cores <- parallel::detectCores()#
n_workers <- max(1L, min(nrow(escenarios), cores - 1L))#
#
cl <- parallel::makeCluster(n_workers)#
#
# Cada proceso carga los paquetes y compila el C++ una sola vez.#
parallel::clusterExport(cl, "cpp_file")#
parallel::clusterEvalQ(cl, {#
  library(Directional)#
  library(sphunif)#
  library(MASS)#
  library(Rcpp)#
  library(mvtnorm)#
  library(MuniCandS)#
  library(copula)#
  Rcpp::sourceCpp(cpp_file)#
  NULL#
})#
#
parallel::clusterExport(cl, c(#
  "n", "p", "n_pow", "alpha", "evlin", "HR.test", "muesnorm",#
  "muesclay", "muesgumbel", "simular_muestra", "ejecutar_escenario",#
  "progress_dir", "actualizar_cada", "guardar_progreso"#
))#
#
# Distribuye escenarios dinámicamente y actualiza el panel mientras espera#
# resultados de los trabajadores.#
parLapply_progreso <- function(cl, X, FUN, ...) {#
  n_tareas <- length(X)#
  n_workers <- length(cl)#
  resultados <- vector("list", n_tareas)#
#
  if (n_tareas == 0L || n_workers == 0L) return(resultados)#
#
  argumentos <- function(i) c(list(X[[i]]), list(...))#
  enviar <- function(worker, tarea) {#
    parallel:::sendCall(cl[[worker]], FUN, argumentos(tarea), tag = tarea)#
  }#
#
  tareas_iniciales <- min(n_tareas, n_workers)#
  for (i in seq_len(tareas_iniciales)) enviar(i, i)#
#
  terminadas <- 0L#
  conexiones <- lapply(cl, function(worker) worker$con)#
  mostrar_progreso()#
  while (terminadas < n_tareas) {#
    # socketSelect permite refrescar el panel aunque ningún escenario haya terminado.#
    hay_resultado <- any(socketSelect(conexiones, timeout = 1))#
    if (!hay_resultado) {#
      mostrar_progreso()#
      next#
    }#
#
    respuesta <- parallel:::recvOneResult(cl)#
    terminadas <- terminadas + 1L#
    siguiente <- terminadas + tareas_iniciales#
    if (siguiente <= n_tareas) enviar(respuesta$node, siguiente)#
    resultados[respuesta$tag] <- list(respuesta$value)#
    mostrar_progreso()#
  }#
#
  parallel:::checkForRemoteErrors(resultados)#
}#
#
pow <- tryCatch(#
  do.call(rbind, parLapply_progreso(#
    cl, split(escenarios, seq_len(nrow(escenarios))), ejecutar_escenario#
  )),#
  finally = parallel::stopCluster(cl)#
)#
#
output_file <- sprintf("powers_type_n=%d_p=%d.RData", n, p)#
save(pow, file = output_file)#
write.csv(pow, sprintf("powers_type_n=%d_p=%d.csv", n, p), row.names = FALSE)#
#
print(pow)#
message("Los archivos de avance de esta corrida quedaron en: ", progress_dir)
Cpi2S
ls()
Rcpp::sourceCpp("MuniCandS/src/funciones.cpp")
ls()
Cpi2S
getws()
getwd()
Rcpp::sourceCpp("MuniCandS/src/funciones.cpp")
# Estimación paralela de potencias para MuniCandS#
# Cada escenario (alternativa, parámetro) se ejecuta en un proceso independiente.#
#
library(Directional)#
library(sphunif)#
library(MASS)#
library(Rcpp)#
library(mvtnorm)#
library(MuniCandS)#
library(copula)#
library(parallel)#
#
# Ajustar si el archivo C++ se encuentra en otra ubicación.#
cpp_file <- path.expand("~/MuniCandS/src/funciones.cpp")#
if (!file.exists(cpp_file)) {#
  stop("No se encontró el archivo C++: ", cpp_file)#
}#
Rcpp::sourceCpp(cpp_file)#
#
evlin <- function(u, f) {#
  ff <- c(0, sort(f), 1)#
  sf <- max(which(ff <= u))#
  if (sf == length(ff)) {#
    return(1)#
  }#
  ((u - ff[sf]) * sf + (ff[sf + 1] - u) * (sf - 1)) /#
    ((ff[sf + 1] - ff[sf]) * (length(f) + 1))#
}#
#
HR.test <- function(x, B = 500) {#
  n <- nrow(x)#
  p <- ncol(x)#
#
  theta <- acos(pmin(pmax(x %*% t(x), -1), 1))#
  stat_obs <- sum(cos(theta[lower.tri(theta)]))#
#
  stat_boot <- numeric(B)#
  for (b in seq_len(B)) {#
    u <- matrix(rnorm(n * p), n, p)#
    u <- u / sqrt(rowSums(u^2))#
    theta_b <- acos(pmin(pmax(u %*% t(u), -1), 1))#
    stat_boot[b] <- sum(cos(theta_b[lower.tri(theta_b)]))#
  }#
#
  list(statistic = stat_obs, p.value = mean(stat_boot >= stat_obs))#
}#
#
Cpi2S=function(Phi){#
	Phi=c(Phi,0)#
	Z=cos(Phi[1])#
	for(j in 2:(length(Phi)))Z=c(Z,cos(Phi[j])*prod(sin(Phi[1:(j-1)])))#
	return(Z)#
}#
#
C2Cpi=function(U){#
	p=length(U)#
	if(p>6)print('La dimensión no debe ser mayor que 6')#
	phi=c()#
	for (i in 1:p)phi=c(phi,max(which(U6[,6-p+i]<=U[i]))/1000)#
	phi[p]=2*phi[p]#
	return(phi)#
}#
#
C2S=function(U){#
	n=nrow(U)#
	Z=c()#
	for(i in 1:n)Z=rbind(Z,Cpi2S(C2Cpi(U[i,])))#
	return(Z)#
}#
#
S2C=function(Z){#
	if(is.matrix(Z)==TRUE) n=nrow(Z) else n=1#
	if(n==1)U=Cpi2C(S2Cpi(Z)) else {#
	U=c()#
	for(i in 1:n)U=rbind(U,Cpi2C(S2Cpi(Z[i,])))}#
	return(U)#
}#
Rcpp::sourceCpp("MuniCandS/src/funciones.cpp")#
muesnorm <- function(n, p, rho) {#
  mues <- do.call(rbind, lapply(seq_len(n), function(i) {#
    C2S(rCopula(1, normalCopula(rho, p)))#
  }))#
  mues#
}#
#
# Ambas funciones generan una muestra de tamaño n (no n^2).#
muesclay <- function(n, p, kk) {#
  cop <- claytonCopula(param = kk, dim = p)#
  mues <- C2S(rCopula(n, cop))#
  while (anyNA(mues)) {#
    mues <- C2S(rCopula(n, cop))#
  }#
  mues#
}#
#
muesgumbel <- function(n, p, kk) {#
  cop <- archmCopula(family = "gumbel", dim = p, param = kk)#
  mues <- C2S(rCopula(n, cop))#
  while (anyNA(mues)) {#
    mues <- C2S(rCopula(n, cop))#
  }#
  mues#
}#
#
n <- 50#
p <- 3#
n_pow <- 20#
alpha <- 0.05#
#
laska <- list(#
  c(.2, .5, .8, 1, 1.2), c(.5, 1, 1.5, 2),#
  c(1, 2, 3, 4), c(1, 2, 3),#
  c(.2, .4, .6, .8), c(.2, .4, .6, .8),#
  c(.5, 1, 1.5, 2), c(1.25, 1.5, 1.75, 2)#
)#
#
escenarios <- do.call(rbind, lapply(seq_along(laska), function(alte) {#
  data.frame(alte = alte, kk = laska[[alte]])#
}))#
escenarios$id <- seq_len(nrow(escenarios))#
#
# Los trabajadores escriben aquí su avance. Se crea una carpeta nueva por corrida.#
progress_dir <- file.path(#
  getwd(), paste0("progreso_potencias_", format(Sys.time(), "%Y%m%d_%H%M%S"))#
)#
dir.create(progress_dir, recursive = TRUE)#
actualizar_cada <- 5L  # Actualiza cada cinco réplicas; usar 1L para cada réplica.#
#
guardar_progreso <- function(escenario, replica, total, estado = "running") {#
  registro <- list(#
    id = escenario$id, alte = escenario$alte, kk = escenario$kk,#
    replica = replica, total = total, estado = estado, instante = Sys.time()#
  )#
  destino <- file.path(progress_dir, sprintf("escenario_%02d.rds", escenario$id))#
  temporal <- tempfile(pattern = "avance_", tmpdir = progress_dir)#
  saveRDS(registro, temporal)#
  file.rename(temporal, destino)#
  invisible(NULL)#
}#
