leer_progreso <- function() {#
  archivos <- list.files(progress_dir, pattern = "\\.rds$", full.names = TRUE)#
  registros <- lapply(archivos, function(archivo) {#
    tryCatch(readRDS(archivo), error = function(e) NULL)#
  })#
  Filter(Negate(is.null), registros)#
}#
#
mostrar_progreso <- function() {#
  registros <- leer_progreso()#
  terminados <- sum(vapply(registros, function(x) x$estado == "completed", logical(1)))#
  activos <- Filter(function(x) x$estado == "running", registros)#
#
  if (interactive()) cat("\014")#
  cat(sprintf("Escenarios terminados: %d/%d\n", terminados, nrow(escenarios)))#
  cat("Cada barra corresponde a un escenario que está ejecutándose.\n\n")#
#
  if (length(activos) == 0L && terminados < nrow(escenarios)) {#
    cat("Iniciando trabajadores...\n")#
  }#
  for (x in activos) {#
    ancho <- 32L#
    proporción <- x$replica / x$total#
    llenos <- round(ancho * proporción)#
    barra <- paste0(strrep("=", llenos), strrep("-", ancho - llenos))#
    cat(sprintf(#
      "Alt. %d, k = %-5s [%s] %3d/%d (%5.1f%%)\n",#
      x$alte, format(x$kk, trim = TRUE), barra, x$replica, x$total, 100 * proporción#
    ))#
  }#
  flush.console()#
}#
#
cores <- parallel::detectCores(logical = FALSE)#
if (is.na(cores) || cores < 2) cores <- parallel::detectCores()#
n_workers <- max(1L, min(nrow(escenarios), cores - 1L))#
#
cl <- parallel::makeCluster(n_workers)#
#
# Cada proceso carga los paquetes y compila el C++ una sola vez.#
parallel::clusterExport(cl, "cpp_file")#
parallel::clusterEvalQ(cl, {#
  library(Directional)#
  library(sphunif)#
  library(MASS)#
  library(Rcpp)#
  library(mvtnorm)#
  library(MuniCandS)#
  library(copula)#
  Rcpp::sourceCpp(cpp_file)#
  NULL#
})#
#
parallel::clusterExport(cl, c(#
  "n", "p", "n_pow", "alpha", "evlin", "HR.test", "muesnorm",#
  "muesclay", "muesgumbel", "simular_muestra", "ejecutar_escenario",#
  "progress_dir", "actualizar_cada", "guardar_progreso"#
))#
#
# Distribuye escenarios dinámicamente y actualiza el panel mientras espera#
# resultados de los trabajadores.#
parLapply_progreso <- function(cl, X, FUN, ...) {#
  n_tareas <- length(X)#
  n_workers <- length(cl)#
  resultados <- vector("list", n_tareas)#
#
  if (n_tareas == 0L || n_workers == 0L) return(resultados)#
#
  argumentos <- function(i) c(list(X[[i]]), list(...))#
  enviar <- function(worker, tarea) {#
    parallel:::sendCall(cl[[worker]], FUN, argumentos(tarea), tag = tarea)#
  }#
#
  tareas_iniciales <- min(n_tareas, n_workers)#
  for (i in seq_len(tareas_iniciales)) enviar(i, i)#
#
  terminadas <- 0L#
  conexiones <- lapply(cl, function(worker) worker$con)#
  mostrar_progreso()#
  while (terminadas < n_tareas) {#
    # socketSelect permite refrescar el panel aunque ningún escenario haya terminado.#
    hay_resultado <- any(socketSelect(conexiones, timeout = 1))#
    if (!hay_resultado) {#
      mostrar_progreso()#
      next#
    }#
#
    respuesta <- parallel:::recvOneResult(cl)#
    terminadas <- terminadas + 1L#
    siguiente <- terminadas + tareas_iniciales#
    if (siguiente <= n_tareas) enviar(respuesta$node, siguiente)#
    resultados[respuesta$tag] <- list(respuesta$value)#
    mostrar_progreso()#
  }#
#
  parallel:::checkForRemoteErrors(resultados)#
}#
#
pow <- tryCatch(#
  do.call(rbind, parLapply_progreso(#
    cl, split(escenarios, seq_len(nrow(escenarios))), ejecutar_escenario#
  )),#
  finally = parallel::stopCluster(cl)#
)#
#
output_file <- sprintf("powers_type_n=%d_p=%d.RData", n, p)#
save(pow, file = output_file)#
write.csv(pow, sprintf("powers_type_n=%d_p=%d.csv", n, p), row.names = FALSE)#
