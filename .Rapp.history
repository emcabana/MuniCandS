library(Rcpp)#
#
cppFunction(’#
int contar_excedencias(double T_H2, int n, int H_length, int repet, int seed = 123) {#
int contador = 0;#
std::srand(seed); // Para reproducibilidad#
for (int r = 0; r < repet; ++r) {#
// Generar matriz aleatoria U (n x H_length)#
std::vector<std::vector<double>> U(n, std::vector<double>(H_length));#
for (int i = 0; i < n; ++i) {#
for (int j = 0; j < H_length; ++j) {#
U[i][j] = ((double) rand() / RAND_MAX); // Uniforme (0,1)#
}#
}#
// Calcular estad´ ıstico T2#
double T2 = 0.0;#
for (int h = 0; h < n; ++h) {#
for (int i = 0; i < n; ++i) {#
double prod = 1.0;#
for (int j = 0; j < H_length; ++j) {#
double val_h = U[h][j];#
double val_i = U[i][j];#
double term = (val_h * val_h + val_i * val_i) / 2.0 - std::max(val_h, val_i) + 1.0 / 3.0;#
prod *= term;#
}#
T2 += prod;#
}#
}#
T2 = T2 / n;if (T2 > T_H2) {#
contador++;#
}#
}#
return contador;#
}#
’)#
#
mut_rapido <- function(X, hmax = Inf, repet = 999, semilla = 123) {#
if (!is.matrix(X)) stop("X debe ser una matriz")#
n <- nrow(X)#
p <- ncol(X)#
# Generar subconjuntos H#
H_list <- list()#
for (h in 1:min(hmax, p)) {#
H_list <- c(H_list, combn(p, h, simplify = FALSE))#
}#
pmin <- Inf#
suma <- 0#
for (H in H_list) {#
# Calcular estadıstico observado con C++#
T_H2 <- calcular_estadistico(X, as.integer(H))#
# Calcular p-valor con simulaciones desde C++#
excedencias <- contar_excedencias(T_H2, n, length(H), repet, seed = semilla)#
p_H <- (excedencias + 1) / (repet + 1)#
# Acumular para estadıstico suma#
suma <- suma + qchisq(1 - p_H, df = 1)#
pmin <- min(pmin, p_H)#
}#
m_p_value <- 1 - (1 - pmin)ˆlength(H_list)#
s_p_value <- 1 - pchisq(suma, df = length(H_list))#
return(c(m_p_value = m_p_value, s_p_value = s_p_value))#
}
