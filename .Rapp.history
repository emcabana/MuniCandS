library(nortest)#
library(sn)      #
library(tseries) #
remotes::install_github('emcabana/norTEPtest')#
library(norTEPtest)#
#
# Uniform with variance 1: width must be sqrt(12)#
r_unif_std <- function(n) runif(n, -sqrt(3), sqrt(3))#
#
# Skew-normal#
r_skew <- function(n) {#
  rsn(n, alpha = 5)#
}#
#
# Contaminated normal#
r_contam <- function(n) {#
  rnorm(n, sd = ifelse(runif(n) < 0.9, 1, 5))#
}#
#
apply_tests <- function(x, alpha = 0.05) {#
  c(#
    AD      = ad.test(x)$p.value < alpha,#
    CvM     = cvm.test(x)$p.value < alpha,#
    Lillie  = lillie.test(x)$p.value < alpha,#
    Pearson = pearson.test(x)$p.value < alpha,#
    SW      = shapiro.test(x)$p.value < alpha,#
    JB      = jarque.bera.test(x)$p.value < alpha,#
    TEPsk   = TEPnor(x)$pval<alpha,#
   TEPkur  = TEPnor(x, type="kurt")$pval<alpha#
  )#
}#
#
mc_power <- function(generator, n = 50, M = 1000, alpha = 0.05) {#
  res <- replicate(M, apply_tests(generator(n), alpha))#
  rowMeans(res)#
}#
#
n <- 100#
M <- 5000#
#
# Run simulations#
results <- rbind(#
  Normal   = mc_power(rnorm, n, M),#
  t3       = mc_power(function(n) rt(n, 3), n, M),#
  Uniform  = mc_power(r_unif_std, n, M),#
  Skew     = mc_power(r_skew, n, M),#
  Contam   = mc_power(r_contam, n, M)#
)#
#
#### TEP tests take longer!!#
colnames(results) <- c("AD", "CvM", "Lillie", "Pearson", "SW", "JB","TEPs","TEPk")#
round(results, 3)#
#
############# plot results#
#
library(ggplot2)#
library(tidyr)#
library(dplyr)#
#
# 1. Convert the results matrix to a  data frame#
results_df <- as.data.frame(results) %>%#
  mutate(Distribution = rownames(results)) %>%#
  pivot_longer(cols = -Distribution, #
               names_to = "Test", #
               values_to = "Power")#
#
# Plot ( fixed n)#
ggplot(results_df, aes(x = Distribution, y = Power, fill = Test)) +#
  geom_bar(stat = "identity", position = "dodge") +#
  geom_hline(yintercept = 0.05, linetype = "dashed", color = "red") +#
  labs(title = "Power Comparison of Normality Tests (n=50)",#
       subtitle = "Red line indicates the Significance Level (alpha = 0.05)",#
       y = "Rejection Rate (Power)",#
       x = "True Underlying Distribution") +#
  theme_minimal() +#
  scale_fill_brewer(palette = "Set1")#
#
library(RColorBrewer)#
display.brewer.all()#
#
######### Effect of the sample size on power#
#Distribution Generators #
r_unif_std <- function(n) runif(n, -sqrt(3), sqrt(3))#
r_skew     <- function(n) rsn(n, alpha = 5)#
r_contam   <- function(n) rnorm(n, sd = ifelse(runif(n) < 0.9, 1, 5))#
r_t3       <- function(n) rt(n, 3)#
#
#  Testing Function #
# Note: pearson.test and others can fail on very small n or constant data#
# We use tryCatch to ensure the simulation doesn't crash#
# Tep tests take too long...#
apply_tests <- function(x, alpha = 0.05) {#
  safe_p <- function(expr) tryCatch(expr$p.value, error = function(e) NA)#
  c(#
    AD      = safe_p(ad.test(x)) < alpha,#
    CvM     = safe_p(cvm.test(x)) < alpha,#
    Lillie  = safe_p(lillie.test(x)) < alpha,#
    SW      = safe_p(shapiro.test(x)) < alpha,#
    JB      = safe_p(jarque.bera.test(x)) < alpha#
  )#
}#
#
# Simulation Loop#
n_values <- c(20, 50, 100, 200, 400)#
M <- 10000  # Number of Monte Carlo iterations#
dist_list <- list(#
  "Normal"  = rnorm,#
  "t(3)"    = r_t3,#
  "Uniform" = r_unif_std,#
  "Skewed"  = r_skew,#
  "Contam"  = r_contam#
)#
#
all_results <- data.frame()#
#
for (n in n_values) {#
  cat("Simulating n =", n, "...\n")#
  for (dist_name in names(dist_list)) {#
    generator <- dist_list[[dist_name]]#
    # Run MC simulation for this specific n and distribution#
    res <- replicate(M, apply_tests(generator(n)))#
    powers <- rowMeans(res, na.rm = TRUE)#
    # Store results#
    temp_df <- data.frame(#
      n = n,#
      Distribution = dist_name,#
      Test = names(powers),#
      Power = as.numeric(powers)#
    )#
    all_results <- rbind(all_results, temp_df)#
  }#
}#
#
#  Plotting Power Curves #
ggplot(all_results, aes(x = n, y = Power, color = Test)) +#
  geom_line(size = 1) +#
  geom_point() +#
  facet_wrap(~Distribution, scales = "free_y") +#
  geom_hline(yintercept = 0.05, linetype = "dashed", color = "orchid") +#
  labs(title = "Power Curves: Normality Tests vs. Sample Size",#
       subtitle = "The red dashed line is the significance level (0.05)",#
       x = "Sample Size (n)",#
       y = "Power (Rejection Rate)") +#
  theme_minimal()
