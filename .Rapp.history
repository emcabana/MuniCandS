library(Directional)#
library(sphunif)#
library(MASS)#
library(Rcpp)#
library(mvtnorm)#
library(Rfast)#
library(copula)#
#
Rcpp::sourceCpp('/Volumes/ToshibaBlack/MuniCandS/MuniCandS2/R-package-MuniCandS/MuniCandS1/src/funciones.cpp')#
evlin=function(u,f){ff=c(0,sort(f),1)#
	sf=max(which(ff<=u))#
	if(sf==length(ff))return(1) else return(((u-ff[sf])*(sf)+(ff[sf+1]-u)*(sf-1))/((ff[sf+1]-ff[sf])*(length(f)+1)))#
 }#
# Código para la prueba HR, por no estar en spunif ni en otro paquete#
HR.test <- function(x, B = 500) {#
  # x: matriz n x p de vectores unitarios#
  n <- nrow(x)#
  p <- ncol(x)#
  # Estadística observada: suma de cosenos entre pares#
  theta <- acos(pmin(pmax(x %*% t(x), -1), 1))  # matriz de ángulos#
  stat_obs <- sum(cos(theta[lower.tri(theta)]))#
  # Bootstrap bajo H0: datos uniformes en la esfera#
  stat_boot <- numeric(B)#
  for (b in 1:B) {#
    u <- matrix(rnorm(n * p), n, p)#
    u <- u / sqrt(rowSums(u^2))#
    theta_b <- acos(pmin(pmax(u %*% t(u), -1), 1))#
    stat_boot[b] <- sum(cos(theta_b[lower.tri(theta_b)]))#
  }#
  pval <- mean(stat_boot >= stat_obs)#
  list(statistic = stat_obs, p.value = pval)#
}#
muesnorm=function(n,p,rho){mues=c()#
	for(i in 1:n)mues=rbind(mues,C2S(rCopula(1,normalCopula(rho,p))))#
	return(mues)#
	}#
muesclay=function(n,p,kk){mues=c()#
	for(i in 1:n){mu=tra(rCopula(n, claytonCopula(param = kk, dim = p)))#
		while(is.na(sum(mu)))mu=C2S(rCopula(n, claytonCopula(param = kk, dim = p)))#
		mues=rbind(mues,mu)}#
	return(mues)#
}#
muesgumbel=function(n,p,kk){mues=c()#
	for(i in 1:n){mu=C2S(rCopula(n,archmCopula(family = "gumbel", dim = p, param = kk)))#
		while(is.na(sum(mu)))mu=tra(rCopula(n,archmCopula(family = "gumbel", dim = p, param = kk)))#
		mues=rbind(mues,mu)}#
	return(mues)#
}#
#
# Definiciones de las alternativas#
p=4#
n=50#
#
# 1. VMF con concentración#
mu1 <- c(1, rep(0, p - 1))#
mu1 <- mu1 / sqrt(sum(mu1^2))#
n_pow=100#
#
alte=1#
#
for(kk in c(.2,.4,.6,.8,1,2,3)){#
plot(0,0,xlim=c(0,n_pow),ylim=c(0,n_pow))#
#
alt_vmf <- rvmf(n, mu1, k = kk)#
#
results <- matrix(NA, nrow = n_pow, ncol = 6)#
# colnames(results) <- c("param","Rayleigh", "Bingham", "Giné Fn","HR","max","sum")#
set.seed(123)#
for (i in 1:n_pow) {if(i==10*floor(i/10)){#
		lines(i,i,type='p')#
		 Sys.sleep(0.01)       # Pausa para que se vea el punto#
  				flush.console()}       # Asegura que se actualice la consola#
  sample <- rvmf(n, mu1, k = kk)  # alternativa fija#
#
 results[i, 1] <- unif_test(sample, type="Rayleigh",p_value="MC")$p.value < 0.05#
 results[i, 2] <- unif_test(sample, type="Bingham",p_value="MC")$p.value < 0.05#
# results[i, 3] <- unif_test(sample, type="Sobolev",p_value="MC")$p.value < 0.05#
 results[i, 3] <- unif_test(sample, type="Gine_Fn",p_value="MC")$p.value < 0.05#
 results[i, 4] <- HR.test(sample)$p.value < 0.05#
 results[i,5:6] <- mun1(sample,type='US',repet=500,MC=500)<c(.05,.05)#
 #results[i,8:9] <- c(0,0) #mun11(sample,type='US',n_sim=50,n_mc=50)<c(.05,.05)#
 #results[i,5:6] <- mun2(sample,type='US',n_sim=500,n_mc=500,n_ort=10)$pvals<c(.05,.05)#
}#
#
# Estimar potencia#
#
print(c(kk,100*colMeans(results)))#
#
