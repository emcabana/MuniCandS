# Estimación paralela de potencias para MuniCandS#
# Cada escenario (alternativa, parámetro) se ejecuta en un proceso independiente.#
#
# Carga versión de MuniCandS#
if (!require(remotes)) {#
  install.packages("remotes")#
}#
remotes::install_github("emcabana/MuniCandS")#
packageVersion("MuniCandS")#
if (!requireNamespace('mvtnorm', quietly = TRUE))install.packages('mvtnorm')#
#
if (!requireNamespace('Rcpp', quietly = TRUE))install.packages('Rcpp')#
#
if (!requireNamespace('parallel', quietly = TRUE))install.packages('parallel')#
#
if (!requireNamespace('pbmcapply', quietly = TRUE))install.packages('pbmcapply')#
#
if (!requireNamespace('copula', quietly = TRUE))install.packages('copula')#
#
if (!requireNamespace('sn', quietly = TRUE))install.packages('sn')#
#
if (!requireNamespace('ellipticalsymmetry', quietly = TRUE))install.packages('ellipticalsymmetry')#
#
library(mvtnorm)#
library(Rcpp)#
library(MuniCandS)#
library(parallel)#
library(pbmcapply)#
library(copula)#
library(sn)#
library(ellipticalsymmetry)#
#
