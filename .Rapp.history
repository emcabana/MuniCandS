calpowI_parallel<-function(n, p, alte, n_sim, cores=parallelly::availableCores() - 1) {#
#
one_repI <- function(i) {#
  muestra <- switch(alte,#
    nordia(n,p,.5),#
    nordia(n,p,1),#
    nordia(n,p,1.5),#
    nordia(n,p,2),#
    nordia(n,p,2.5),#
    nordia(n,p,3),#
    afin(n,p,.2),#
    afin(n,p,.3),#
    afin(n,p,.4),#
    afin(n,p,.5),#
    afin(n,p,.6),#
    afin(n,p,.7),#
    afin(n,p,.8),#
#    muesclayN(n,p,.5),#
#    muesclayN(n,p,1),#
#    muesclayN(n,p,1.5),#
#    muesclayN(n,p,2),#
#    muesclayN(n,p,2.5),#
#   muesgumbelN(n,p,1),#
#    muesgumbelN(n,p,2),#
#   muesgumbelN(n,p,3),#
#    muesgumbelN(n,p,4),#
    matrix(rnorm(n*p),n,p)#
  )#
  # Silenciar todo lo que impriman las funciones internas#
  invisible(capture.output({#
    muestrac=muestra-colMeans(muestra)#
#    tb=test_baringhaus(muestra)#
#    th=test_hhm(muestra)#
    ret <- c(#
  #    tb$pval_asin<.05,#
