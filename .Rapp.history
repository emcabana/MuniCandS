mut_rapido <- function(X, hmax = Inf, repet = 999, semilla = 123) {#
if (!is.matrix(X)) stop("X debe ser una matriz")#
n <- nrow(X)#
p <- ncol(X)#
# Generar subconjuntos H#
H_list <- list()#
for (h in 1:min(hmax, p)) {#
H_list <- c(H_list, combn(p, h, simplify = FALSE))#
}#
pmin <- Inf#
suma <- 0#
for (H in H_list) {#
# Calcular estadıstico observado con C++#
T_H2 <- calcular_estadistico(X, as.integer(H))#
# Calcular p-valor con simulaciones desde C++#
excedencias <- contar_excedencias(T_H2, n, length(H), repet, seed = semilla)#
p_H <- (excedencias + 1) / (repet + 1)#
# Acumular para estadıstico suma#
suma <- suma + qchisq(1 - p_H, df = 1)#
pmin <- min(pmin, p_H)#
}#
#
m_p_value <- 1 - (1 - pmin)^length(H_list)#
s_p_value <- 1 - pchisq(suma, df = length(H_list))#
return(c(m_p_value = m_p_value, s_p_value = s_p_value))#
}
powermutrap <- function(alter,n,p,hmax=Inf,repetx=1000,alpha=.05){#
pvals=matrix(0,1000,2)#
pvalsYM=matrix(0,1000,4)#
set.seed(123)#
for(rep in 1:repetx){#
X=matrix(0,n,p)#
for(i in 1:n)X[i,]=alter(p)pvals[rep,]=mut_rapido(X,hmax)#
pvalsYM[rep,]=c(unif.2017YMq(X)$p.value,#
unif.2017YMi(X,type=’Q1’)$p.value,#
unif.2017YMi(X,type=’Q2’)$p.value,#
unif.2017YMi(X,type=’Q3’)$p.value)#
}#
return(c(mean(pvalsYM[,1]<.05),mean(pvalsYM[,2]<.05),mean(pvalsYM[,3]<.05),mean(pvalsYM[,4]<.05),mean(pvals[,1]<.05),mean(pvals[,2]<.05)))#
}
