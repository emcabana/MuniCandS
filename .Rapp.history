if (!file.exists(cpp_file)) {#
  stop("No se encontró el archivo C++: ", cpp_file)#
}#
Rcpp::sourceCpp(cpp_file, env = globalenv())#
#
# C2S se compila en cada sesión R. Esta envoltura busca la versión que#
# corresponde al proceso actual, incluido cada trabajador paralelo.#
aplicar_C2S <- function(x) {#
  get("C2S", envir = .GlobalEnv, inherits = FALSE)(x)#
}#
#
evlin <- function(u, f) {#
  ff <- c(0, sort(f), 1)#
  sf <- max(which(ff <= u))#
  if (sf == length(ff)) {#
    return(1)#
  }#
  ((u - ff[sf]) * sf + (ff[sf + 1] - u) * (sf - 1)) /#
    ((ff[sf + 1] - ff[sf]) * (length(f) + 1))#
}#
cppFunction('#
NumericVector S2Cpi(NumericVector x) {#
	int p = x.size() - 1;#
	NumericVector phi(p);#
	for (int j = 0; j < p; ++j) {#
    double denom = 1.0;#
    for (int k = 0; k < j; ++k) {#
      denom *= sin(phi[k]);#
    }#
    phi[j] = acos(x[j] / (denom == 0 ? 1.0 : denom));#
  }#
  if ( x[p] < 0 ) {#
        phi[p-1]=2*M_PI-phi[p-1];#
    } #
  return phi;#
}#
')#
#
Cpi2S=function(Phi){#
	Phi=c(Phi,0)#
	Z=cos(Phi[1])#
	for(j in 2:(length(Phi)))Z=c(Z,cos(Phi[j])*prod(sin(Phi[1:(j-1)])))#
	return(Z)#
}#
#
cppFunction('#
NumericVector Cpi2C(NumericVector phi) {#
  int p = phi.size();#
  NumericVector u(p);#
#
  for (int j = 0; j < p - 1; ++j) {#
    // Compute I_j(phi_j) and normalize#
    double num = 0.0, denom = 0.0;#
    int N = 1000;#
    double h = M_PI / N;#
    for (int i = 0; i <= N; ++i) {#
      double t = i * h;#
      double w = (i == 0 || i == N) ? 0.5 : 1.0;#
      double f = pow(sin(t), p - j - 1);#
      if (t <= phi[j]) num += w * f;#
      denom += w * f;#
    }#
    u[j] = h * num / (h * denom);#
  }#
#
  // Final coordinate: φ_p / (2π)#
  u[p - 1] = phi[p - 1] / (2.0 * M_PI);#
#
  return u;#
}#
')#
#
U6=c()#
for(phi in seq(0,pi,length.out=1000*pi))U6=rbind(U6,Cpi2C(c(rep(phi,5),2*phi)))#
C2Cpi=function(U){#
	p=length(U)#
	if(p>6)print('La dimensión no debe ser mayor que 6')#
	phi=c()#
	for (i in 1:p)phi=c(phi,max(which(U6[,6-p+i]<=U[i]))/1000)#
	phi[p]=2*phi[p]#
	return(phi)#
}#
C2S=function(U){#
	n=nrow(U)#
	Z=c()#
	for(i in 1:n)Z=rbind(Z,Cpi2S(C2Cpi(U[i,])))#
	return(Z)#
}#
#
S2C=function(Z){#
	if(is.matrix(Z)==TRUE) n=nrow(Z) else n=1#
	if(n==1)U=Cpi2C(S2Cpi(Z)) else {#
	U=c()#
	for(i in 1:n)U=rbind(U,Cpi2C(S2Cpi(Z[i,])))}#
	return(U)#
}#
altNMix=function(pr,mu,Sigma){Bi=rbinom(n,1,pr)#
return(diag(1-Bi)%*%rmvnorm(n,rep(0,p),diag(p))+diag(Bi)%*%rmvnorm(n,rep(mu,p),Sigma))#
}#
#
B=function(p)matrix(.9,p,p)+.1*diag(p)#
#
muessn=function(n,p,alpha,mu){#
  matrix(as.vector(rmsn(n,xi=rep(mu,p),Omega=diag(p),alpha=rep(alpha,p))),n,p)#
}#
#
muesnormN=function(n,p,rho){mues=c()#
for(i in 1:n)mues=rbind(mues,qnorm(rCopula(1,normalCopula(rho,p))))#
return(mues)#
}#
muesclayN=function(n,p,kk){#
  copula_clayton <- claytonCopula(param = kk, dim = p)#
  mues <- qnorm(rCopula(n, copula_clayton))#
  return(mues)#
}#
#
muesgumbelN=function(n,p,kk){#
  copula_gumbel <- gumbelCopula(param = kk, dim = p)#
  mues <- qnorm(rCopula(n, copula_gumbel))#
  return(mues)#
}#
type='E'#
n <- 50#
p <- 3#
n_pow <- 500#
alpha <- 0.05#
#
laska <- list(#
  c(.5,.7,.9), c(.5,.9), c(1,2,3,4,5), c(1,2,3,4), c(2,3,4,5)#
  )#
#
familias <- c(1,2,3,4,5)#
#
escenarios <- do.call(rbind, lapply(familias, function(alte) {#
  data.frame(alte = alte, kk = laska[[alte]])#
}))#
escenarios$id <- seq_len(nrow(escenarios))#
#
# Los trabajadores escriben aquí su avance. Se crea una carpeta nueva por corrida.#
progress_dir <- file.path(#
  getwd(), paste0("progreso_potencias_", type, '_n=',as.character(n),'_p=',as.character(p),format(Sys.time(), "%Y%m%d_%H%M%S"))#
)#
dir.create(progress_dir, recursive = TRUE)#
actualizar_cada <- 10L  # Actualiza cada diez réplicas; usar 1L para cada réplica.#
#
guardar_progreso <- function(escenario, replica, total, estado = "running") {#
  registro <- list(#
    id = escenario$id, alte = escenario$alte, kk = escenario$kk,#
    replica = replica, total = total, estado = estado, instante = Sys.time()#
  )#
  destino <- file.path(progress_dir, sprintf("escenario_%02d.rds", escenario$id))#
  temporal <- tempfile(pattern = "avance_", tmpdir = progress_dir)#
  saveRDS(registro, temporal)#
  file.rename(temporal, destino)#
  invisible(NULL)#
}#
#
simular_muestra <- function(alte, kk, n, p) {#
  if (alte == 1) return(altNMix(kk, 3, diag(p)))#
  if (alte == 2) return(altNMix(kk, 0, B(p)))#
  if (alte == 3) return(muessn(n, p, kk, 0))#
  if (alte == 4) return(muesclayN(n, p, kk))#
  if (alte == 5) return(muesgumbelN(n, p, kk))#
  stop("Alternativa desconocida: ", alte)#
}#
#
ejecutar_escenario <- function(escenario) {#
  # Semilla específica por escenario: reproducible aunque cambie el número de núcleos.#
  set.seed(10000L + escenario$id)#
#
  alte <- escenario$alte#
  kk <- escenario$kk#
  message(sprintf("Iniciando alternativa %d, k = %s", alte, kk))#
  results <- matrix(NA_real_, nrow = n_pow, ncol = 6,#
                    dimnames = list(NULL, c("MPQ","Schott","max","sum","maxp","sump")))#
  guardar_progreso(escenario, replica = 0L, total = n_pow)#
  paso <- "inicio"#
muestra <- NULL#
#
max_intentos <- 20L#
#
for (i in seq_len(n_pow)) {#
  exito <- FALSE#
#
  for (intento in seq_len(max_intentos)) {#
    paso <- "simular_muestra"#
#
    resultado <- tryCatch({#
      muestra <- simular_muestra(alte, kk, n, p)#
#
      if (anyNA(muestra) || any(!is.finite(muestra))) {#
        stop("La muestra contiene NA, NaN o Inf.")#
      }#
#
      paso <- "MuniCandS: caché E"#
      cach <- MuniCandS(muestra, type = "E", n_sim = 500, n_mc = 500,#
                        return_cache = TRUE)$cache#
#
      paso <- "MuniCandS: caché E, hmin = 2"#
      cach2 <- MuniCandS(muestra, type = "E", hmin = 2, n_sim = 500,#
                         n_mc = 500,  return_cache = TRUE)$cache#
#
      paso <- "MPQ"#
      r1 <- MPQ(muestra)[4] < alpha#
      paso <- "Shott"#
      r2 <- Schott(muestra)[4] < alpha#
      paso <- "MuniCandS: pvals E"#
      r34 <- MuniCandS(muestra, type = "E", n_sim = 500, n_mc = 500,#
                        cache = cach)$pvals < alpha#
#
      paso <- "MuniCandS: pvals E, hmin = 2"#
      r56 <- MuniCandS(muestra, type = "E", hmin = 2, n_sim = 500,#
                       n_mc = 500,  cache = cach2)$pvals < alpha#
#
      c(r1, r2, r34, r56)#
    }, error = function(e) {#
      ultimo_error <<- list(#
        alternativa = alte,#
        k = kk,#
        replica = i,#
        intento = intento,#
        paso = paso,#
        mensaje = conditionMessage(e),#
        instante = Sys.time()#
      )#
      saveRDS(#
        ultimo_error,#
        file.path(#
          progress_dir,#
          sprintf("error_escenario_%02d.rds", escenario$id)#
        )#
      )#
      message(sprintf(#
        "Alt. %d, k = %s, réplica %d: se descarta intento %d (%s; %s)",#
        alte, kk, i, intento, paso, conditionMessage(e)#
      ))#
      NULL#
    })#
    if (!is.null(resultado)) {#
      results[i, ] <- resultado#
      exito <- TRUE#
      break#
    }#
  }#
#
if (!exito) {#
  guardar_progreso(#
    escenario,#
    replica = i - 1L,#
    total = n_pow,#
    estado = "failed"#
  )#
#
  stop(sprintf(#
    "Alt. %d, k = %s: la réplica %d falló %d veces seguidas.",#
    alte, kk, i, max_intentos#
  ))#
}#
  if (i %% actualizar_cada == 0L || i == n_pow) {#
    guardar_progreso(escenario, replica = i, total = n_pow)#
  }#
}#
resultado_final <- c(alte = alte, kk = kk, 100 * colMeans(results))#
#
archivo_resultado <- file.path(#
  progress_dir,#
  sprintf("resultado_escenario_%02d.rds", escenario$id)#
)#
saveRDS(resultado_final, archivo_resultado)#
#
guardar_progreso(escenario, replica = n_pow, total = n_pow, estado = "completed")#
#
resultado_final#
}#
#
leer_progreso <- function() {#
  archivos <- list.files(#
    progress_dir,#
    pattern = "^escenario_[0-9]+\\.rds$",#
    full.names = TRUE#
  )#
  registros <- lapply(archivos, function(archivo) {#
    tryCatch(readRDS(archivo), error = function(e) NULL)#
  })#
  Filter(Negate(is.null), registros)#
}#
#
mostrar_progreso <- function() {#
  registros <- leer_progreso()#
  terminados <- sum(vapply(registros, function(x) x$estado == "completed", logical(1)))#
  activos <- Filter(function(x) x$estado == "running", registros)#
#
  if (interactive()) cat("\014")#
  cat(sprintf("Escenarios terminados: %d/%d\n", terminados, nrow(escenarios)))#
  cat(sprintf("Trabajadores creados: %d\n", length(cl)))#
  cat("Cada barra corresponde a un escenario que está ejecutándose.\n\n")#
#
  if (length(activos) == 0L && terminados < nrow(escenarios)) {#
    cat("Iniciando trabajadores...\n")#
  }#
  for (x in activos) {#
    ancho <- 32L#
    proporción <- x$replica / x$total#
    llenos <- round(ancho * proporción)#
    barra <- paste0(strrep("=", llenos), strrep("-", ancho - llenos))#
    cat(sprintf(#
      "Alt. %d, k = %-5s [%s] %3d/%d (%5.1f%%)\n",#
      x$alte, format(x$kk, trim = TRUE), barra, x$replica, x$total, 100 * proporción#
    ))#
  }#
  flush.console()#
}#
#
cores <- parallel::detectCores(logical = FALSE)#
if (is.na(cores) || cores < 2) cores <- parallel::detectCores()#
n_workers <- max(1L, min(nrow(escenarios), cores - 1L))#
n_workers <- min(cores-1L, nrow(escenarios))#
cl <- parallel::makeCluster(n_workers)#
#
cat("Trabajadores realmente creados:", length(cl), "\n")#
stopifnot(length(cl) == n_workers)#
# Cada proceso carga los paquetes y compila el C++ una sola vez.#
parallel::clusterExport(cl, c(#
  "n", "p", "n_pow", "alpha", "evlin",#
  "aplicar_C2S", "B", "altNMix","muessn", "muesgumbelN","muesclayN",#
  "simular_muestra", "ejecutar_escenario",#
  "progress_dir", "actualizar_cada", "guardar_progreso"#
))#
parallel::clusterExport(cl, "cpp_file", envir = .GlobalEnv)#
parallel::clusterEvalQ(cl, {#
  library(mvtnorm)#
  library(Rcpp)#
  library(MuniCandS)#
  library(parallel)#
  library(pbmcapply)#
  library(copula)#
  library(sn)#
  library(ellipticalsymmetry)#
  Rcpp::sourceCpp(cpp_file, env = globalenv())#
  NULL#
})#
parallel::clusterExport(cl, c("U6", "Cpi2S", "C2Cpi", "C2S"))#
#
parallel::clusterExport(cl, c(#
  "n", "p", "n_pow", "alpha", "evlin", "aplicar_C2S", #
"simular_muestra", "ejecutar_escenario",#
  "progress_dir", "actualizar_cada", "guardar_progreso",#
"altNMix","muessn","muesclayN","muesgumbelN","B"#
))#
#
# Distribuye escenarios dinámicamente y actualiza el panel mientras espera#
# resultados de los trabajadores.#
#
intervalo_panel <- 30  # segundos#
#
parLapply_progreso <- function(cl, X, FUN, ...) {#
  n_tareas <- length(X)#
  n_workers <- length(cl)#
  resultados <- vector("list", n_tareas)#
#
  if (n_tareas == 0L || n_workers == 0L) return(resultados)#
#
  argumentos <- function(i) c(list(X[[i]]), list(...))#
  enviar <- function(worker, tarea) {#
    parallel:::sendCall(cl[[worker]], FUN, argumentos(tarea), tag = tarea)#
  }#
#
  tareas_iniciales <- min(n_tareas, n_workers)#
  ultimo_error <- NULL#
  for (i in seq_len(tareas_iniciales)) enviar(i, i)#
#
  terminadas <- 0L#
  conexiones <- lapply(cl, function(worker) worker$con)#
  mostrar_progreso()#
ultima_actualizacion <- Sys.time()#
#
while (terminadas < n_tareas) {#
  hay_resultado <- any(socketSelect(conexiones, timeout = 1))#
#
  ahora <- Sys.time()#
  debe_actualizar <- as.numeric(#
    difftime(ahora, ultima_actualizacion, units = "secs")#
  ) >= intervalo_panel#
#
  if (!hay_resultado) {#
    if (debe_actualizar) {#
      mostrar_progreso()#
      flush.console()#
      ultima_actualizacion <- ahora#
    }#
    next#
  }#
#
  respuesta <- parallel:::recvOneResult(cl)#
  terminadas <- terminadas + 1L#
  siguiente <- terminadas + tareas_iniciales#
#
  if (siguiente <= n_tareas) {#
    enviar(respuesta$node, siguiente)#
  }#
#
  resultados[respuesta$tag] <- list(respuesta$value)#
#
  if (debe_actualizar || terminadas == n_tareas) {#
    mostrar_progreso()#
    flush.console()#
    ultima_actualizacion <- ahora#
  }#
}#
  parallel:::checkForRemoteErrors(resultados)#
}#
#
pow <- tryCatch(#
  do.call(rbind, parLapply_progreso(#
    cl, split(escenarios, seq_len(nrow(escenarios))), ejecutar_escenario#
  )),#
  error = function(e) {#
    message("La corrida falló: ", conditionMessage(e))#
    ultimo_error <- list(#
      mensaje  = conditionMessage(e),#
      instante = Sys.time()#
    )#
    saveRDS(#
      ultimo_error,#
      file.path(progress_dir, "error_general.rds")#
    )#
    NULL#
  },#
  finally = parallel::stopCluster(cl)#
)#
if (!is.null(pow)) {#
  save(pow, file = paste(type,'_n=',as.character(n),'_p=',as.character(p),sep=''))#
  write.csv(pow, sprintf("powers_type_n=%d_p=%d.csv", n, p), row.names = FALSE)#
  print(pow)#
}#
#
message("Los archivos de avance de esta corrida quedaron en: ", progress_dir)
