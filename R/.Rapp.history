S2C <- function(Z) {#
  if (is.matrix(Z)) {#
    n <- nrow(Z)#
    U <- matrix(NA, n, ncol(Z)-1)#
    for (i in 1:n) U[i, ] <- Cpi2C(S2Cpi(Z[i, ]))#
  } else {#
    U <- Cpi2C(S2Cpi(Z))#
  }#
  return(U)#
}
S2C(matrix(c(1,0,0,0,1,0,0,0,1),3nrow=3)))
